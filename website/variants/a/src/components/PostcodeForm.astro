---
// Inline postcode start (conversion-strategy §2.2). GET to the sign-up route with ?postcode=…&entry=…(&plan=…).
// The sign-up page validates again and fires `signup_started` for the first valid postcode.
import { copy, signupHref, type Locale } from '../content/i18n';
import Icon from './Icon.astro';
interface Props { locale: Locale; id: string; entry: string; plan?: string; cta?: string }
const { locale, id, entry, plan, cta } = Astro.props;
const c = copy[locale];
const action = signupHref(locale);
---
<form class="pc" action={action} method="get" novalidate data-postcode>
  <label class="pc__label" for={id}>{c.hero.postcodeLabel}</label>
  <div class="pc__row">
    <input class="pc__input" id={id} name="postcode" type="text" inputmode="numeric" autocomplete="postal-code"
      pattern="[1-9][0-9]{3}" maxlength="4" required placeholder={c.hero.placeholder}
      aria-describedby={`${id}-help ${id}-err`} />
    <input type="hidden" name="entry" value={entry} />
    {plan && <input type="hidden" name="plan" value={plan} />}
    <button class="btn btn--primary pc__btn" type="submit">{cta ?? c.cta}<Icon name="i-arrow-r" size="sm" class="nudge" /></button>
  </div>
  <p class="pc__help" id={`${id}-help`}>{c.hero.postcodeHelp}</p>
  <p class="pc__err" id={`${id}-err`} aria-live="polite"></p>
</form>
