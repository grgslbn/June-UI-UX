---
// Official June script logo (vector trace from the PO asset library), inlined so it takes `color`.
// Logo green #1CA498 by default, white on the ink footer band. Min width 72px (assets README).
import raw from '@shared/assets/logo/june-logo.svg?raw';
interface Props { href?: string; label: string; tone?: 'default' | 'inverse'; width?: number }
const { href, label, tone = 'default', width = 78 } = Astro.props;
const svg = raw
  .replace(/\s(role|aria-label)="[^"]*"/g, '')
  .replace('<svg ', `<svg aria-hidden="true" focusable="false" width="${width}" height="${Math.round(width * 662 / 1069)}" `);
const Tag = href ? 'a' : 'span';
---
<Tag class:list={['logo', tone === 'inverse' && 'logo--inverse']} href={href} aria-label={label} set:html={svg} />
