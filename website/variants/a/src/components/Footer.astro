---
import { href } from '@shared/routes.mjs';
import { copy, type Locale } from '../content/i18n';
import Logo from './Logo.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = copy[locale];
const f = c.footer;
---
<footer class="ftr">
  <div class="wrap">
    <div class="ftr__top">
      <div class="ftr__brand">
        <Logo href={href('home', locale, import.meta.env.BASE_URL)} label={c.home} tone="inverse" />
        <p class="ftr__tagline">{f.tagline}</p>
        <p class="ftr__about">{f.about}</p>
      </div>
      <nav class="ftr__nav" aria-label="Footer">
        <ul>{c.nav.map(n => <li><a href={n.href}>{n.label}</a></li>)}</ul>
        <ul>{f.links.map(l => <li><a href="#" data-todo="route not in scope yet">{l}</a></li>)}</ul>
      </nav>
    </div>
    <section class="ftr__notes" aria-labelledby="fn-title">
      <h2 id="fn-title" class="ftr__notes-title">{f.footnotesLabel}</h2>
      <ol>{f.notes.map((n, i) => <li id={`fn-${i + 1}`}>{n}</li>)}</ol>
    </section>
    <p class="ftr__legal"><span>{f.legal}</span><span>{f.mission}</span></p>
  </div>
</footer>
