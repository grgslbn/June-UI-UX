---
// One of the 7 animated brand icons. Animated WebP (copied as-is, so the 60 frames survive) with the
// static frame (optimised by astro:assets) for prefers-reduced-motion. Always lazy; decorative.
import { getImage } from 'astro:assets';
const anim = import.meta.glob('@shared/assets/icons/*.webp', { eager: true, query: '?url', import: 'default' }) as Record<string, string>;
const still = import.meta.glob('@shared/assets/icons/*-static.png', { eager: true, import: 'default' }) as Record<string, ImageMetadata>;
interface Props { name: 'compare' | 'calculator' | 'home-analysis' | 'home-automatic' | 'home-switch' | 'celebrate' | 'relax'; size?: number; class?: string; eager?: boolean }
const { name, size = 112, class: cls = '', eager = false } = Astro.props;
const a = Object.entries(anim).find(([k]) => k.endsWith(`/icon-${name}.webp`))?.[1];
const s = Object.entries(still).find(([k]) => k.endsWith(`/icon-${name}-static.png`))?.[1];
const st = s ? await getImage({ src: s, width: Math.min(240, size * 2), format: 'webp' }) : null;
---
<span class:list={['aicon', cls]} style={`--aicon:${size}px`} aria-hidden="true">
  <picture>
    {st && <source media="(prefers-reduced-motion: reduce)" srcset={st.src} type="image/webp" />}
    <img src={a} alt="" width={size} height={size} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </picture>
</span>
