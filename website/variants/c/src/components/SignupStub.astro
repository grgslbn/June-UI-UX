---
// Concept-stage stub so the hero form + CTAs land somewhere real. The funnel is built in phase 4.
import Page from '../layouts/Page.astro';
import Logo from './Logo.astro';
import { href } from '@shared/routes.mjs';
interface Props { locale: 'nl-be' | 'fr-be'; }
const { locale } = Astro.props;
const nl = locale === 'nl-be';
const base = import.meta.env.BASE_URL;
---
<Page locale={locale} routeKey="signup" title={nl ? 'Aanmelden | June' : 'Inscription | June'} description={nl ? 'Start je aanmelding bij June in 2 minuten.' : 'Commencez votre inscription June en 2 minutes.'}>
  <header class="masthead"><div class="wrap masthead-in"><Logo href={href('home', locale, base)} /></div></header>
  <main id="inhoud" class="wrap" style="padding-block: 64px 96px; max-width: 720px;">
    <p class="kicker"><span class="kicker-n">1/2</span><span>{nl ? 'Je woning' : 'Votre logement'}</span></p>
    <h1 style="font-size: var(--fs-h2); margin-top: 24px;">{nl ? 'Start met besparen' : 'Commencez à économiser'}</h1>
    <p class="lead" style="margin-top: 16px;">{nl ? 'Concept: de aanmeldflow (postcode, energie, gezin, meter) wordt in de bouwfase uitgewerkt.' : 'Concept : le parcours d’inscription (code postal, énergie, ménage, compteur) sera développé lors de la phase de construction.'}</p>
    <p style="margin-top: 24px;"><a href={href('home', locale, base)}>{nl ? '← Terug naar de startpagina' : '← Retour à l’accueil'}</a></p>
  </main>
</Page>
