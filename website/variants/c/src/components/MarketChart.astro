---
// Hero object: annotated, ILLUSTRATIVE line chart (no market data). Direct labels, no legend box.
// Signature motion: lines draw (700ms), then the red squiggle circles the gap. Fully drawn by default
// and under prefers-reduced-motion; the drawing state is only applied by CSS when html.js is present.
interface Props { c: any; id?: string; }
const { c, id = 'hero' } = Astro.props;
const ch = c.chart;
const xs = [47, 116, 186, 255];
const lines = (arr: string[], x: number, y: number, cls: string, anchor = 'start', dy = 16) =>
  arr.map((t, i) => ({ t, x, y: y + i * dy, cls, anchor }));
const stayY = ch.stay.length > 1 ? 70 : 79;
const labels = [
  ...lines(ch.stay, 300, stayY, 't-stay'),
  ...lines(ch.june, 300, 167, 't-june'),
];
---
<figure class="figure" aria-labelledby={`${id}-t`}>
  <div class="figure-head">
    <p class="figure-title" id={`${id}-t`}>{ch.title}</p>
    <span class="tag">{ch.tag}</span>
  </div>
  <svg class="chart" viewBox="0 0 400 256" role="img" aria-labelledby={`${id}-t ${id}-d`} data-draw>
    <desc id={`${id}-d`}>{ch.desc}</desc>
    <!-- grid + axes -->
    <g aria-hidden="true">
      {[78, 122, 166].map(y => <line class="grid" x1="12" x2="290" y1={y} y2={y} />)}
      {[82, 151, 221].map(x => <line class="grid" x1={x} x2={x} y1="34" y2="222" stroke-dasharray="2 4" />)}
      <line class="axis" x1="12" x2="290" y1="222" y2="222" />
      <path class="axis" d="M12 222V30m-4 6 4-6 4 6" fill="none" />
      <text x="22" y="30" class="t-strong">{ch.y}</text>
      {ch.x.map((t: string, i: number) => <text x={xs[i]} y="244" text-anchor="middle">{t}</text>)}

      <!-- the gap: what loyalty costs -->
      <path class="gap" d="M88 128 L145 124 C151 124 151 106 157 104 L215 98 C221 97 221 82 227 80 L290 74 L290 162 C270 163 250 167 227 167 C222 167 222 160 217 160 C200 161 180 166 157 166 C152 166 152 158 147 158 C130 160 110 165 90 165 Z" />

      <!-- lines -->
      <path class="l-stay draw" pathLength="1" d="M12 170 L76 170 C82 170 82 130 88 128 L145 124 C151 124 151 106 157 104 L215 98 C221 97 221 82 227 80 L290 74" />
      <path class="l-june draw" pathLength="1" d="M12 170 L78 170 C84 170 84 165 90 165 C110 165 130 160 147 158 C152 158 152 166 157 166 C180 166 200 161 217 160 C222 160 222 167 227 167 C250 167 270 163 290 162" />
      <g class="late">
        {[[90, 165], [157, 166], [227, 167]].map(([x, y]) => <circle class="dot" cx={x} cy={y} r="4.5" />)}
      </g>

      <!-- annotation: welcome discount ends -->
      <g class="late">
        {ch.step.map((t: string, i: number) => <text x="20" y={98 + i * 16}>{t}</text>)}
        <path class="leader" d="M44 120 Q 60 146 80 150" />
      </g>

      <!-- direct labels -->
      <g class="late">
        {labels.map(l => <text x={l.x} y={l.y} class={l.cls} text-anchor={l.anchor}>{l.t}</text>)}
      </g>

      <!-- the one red annotation: squiggle circles the gap -->
      <g class="late">
        {ch.gap.map((t: string, i: number) => <text x="258" y={121 + i * 16} class="t-spark" text-anchor="middle">{t}</text>)}
      </g>
      <path class="squiggle draw" pathLength="1" d="M302 118 C300 100 272 94 252 96 C226 98 210 110 212 127 C214 145 238 154 263 152 C290 150 306 136 302 117 C300 107 291 101 281 99" />
    </g>
  </svg>
  <div class="figure-foot">
    <p class="note"><span class="legend-dot" aria-hidden="true"></span>{ch.legend}</p>
    <p class="note">{ch.method}</p>
  </div>
</figure>
