---
// Inline postcode → sign-up step 1 ("sign-up started" = first valid Belgian postcode submitted).
import Icon from './Icon.astro';
import { href } from '@shared/routes.mjs';
interface Props { locale: 'nl-be' | 'fr-be'; c: any; id: string; }
const { locale, c, id } = Astro.props;
const action = href('signup', locale, import.meta.env.BASE_URL);
---
<form class="pc" action={action} method="get" data-pc novalidate>
  <div class="pc-row">
    <div class="field">
      <label for={`pc-${id}`}>{c.form.label}</label>
      <input class="input" id={`pc-${id}`} name="postcode" inputmode="numeric" autocomplete="postal-code" pattern="[1-9][0-9]{3}" maxlength="4" required placeholder={c.form.placeholder} aria-describedby={`pc-${id}-help`} />
    </div>
    <div class="field">
      <span class="field-spacer" aria-hidden="true">&nbsp;</span>
      <button class="btn" type="submit">{c.ui.cta}<Icon name="arrow-r" /></button>
    </div>
  </div>
  <p class="pc-help" id={`pc-${id}-help`} data-help={c.form.help} data-error={c.form.error}>{c.form.help}</p>
</form>
