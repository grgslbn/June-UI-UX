---
import Logo from './Logo.astro';
import { href, LOCALES } from '@shared/routes.mjs';
interface Props { locale: 'nl-be' | 'fr-be'; c: any; }
const { locale, c } = Astro.props;
const base = import.meta.env.BASE_URL;
const other = locale === 'nl-be' ? 'fr-be' : 'nl-be';
---
<footer class="footer" data-sticky-hide>
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <Logo href={href('home', locale, base)} label={locale === 'nl-be' ? 'June, naar de startpagina' : 'June, vers la page d’accueil'} />
        <p class="tagline">{c.footer.tagline}</p>
        <p style="margin-top: 12px; max-width: 36ch;">{c.footer.about}</p>
        <p style="margin-top: 12px; max-width: 36ch;"><strong>{c.footer.mission}</strong></p>
      </div>
      <nav aria-labelledby="ft-nav">
        <h2 id="ft-nav">{c.footer.navTitle}</h2>
        <ul>
          {c.nav.map(([label, h]) => <li><a href={h}>{label}</a></li>)}
          <li><a href="#garantie">{c.L === 'fr' ? 'Garantie de gain' : 'Winstgarantie'}</a></li>
          <li><a href={href('home', other, base)} hreflang={LOCALES[other].html} lang={LOCALES[other].html}>{other === 'fr-be' ? 'Français' : 'Nederlands'}</a></li>
        </ul>
      </nav>
      <div class="footer-notes">
        <h2 id="ft-notes">{c.footer.notesTitle}</h2>
        <ol class="footnotes" aria-labelledby="ft-notes">
          {c.footnotes.map((f) => <li id={f.id}>{f.text}</li>)}
        </ol>
      </div>
    </div>
    <div class="legal">
      <span>{c.footer.legal}</span>
      <span>{c.footer.legalLinks}</span>
    </div>
  </div>
</footer>
