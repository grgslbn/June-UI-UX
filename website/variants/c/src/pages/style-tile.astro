---
// Style tile — Variant C "Honest Market". noindex, not linked from the site.
import Page from '../layouts/Page.astro';
import '../styles/home.css';
import '../styles/how.css';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import MarketChart from '../components/MarketChart.astro';
import PostcodeForm from '../components/PostcodeForm.astro';
import Trust from '../components/Trust.astro';
import Fn from '../components/Fn.astro';
import { homeCopy } from '../i18n/home.js';
import { howCopy } from '../i18n/pages.js';
const c = homeCopy('nl-be');
const swatches = [
  { name: 'Paper', token: '--paper', hex: '#f7f8f6', role: 'Page canvas. Off-white, near-mint "print" stock.', ratio: 'base' },
  { name: 'Paper deep', token: '--paper-deep', hex: '#eef2ef', role: 'Alternate band, table head.', ratio: 'ink 14,3:1' },
  { name: 'Ink 900', token: '--ink-900', hex: '#14232a', role: 'Text, rules, ink block.', ratio: '15,1:1' },
  { name: 'Ink 700', token: '--ink-700', hex: '#435359', role: 'Secondary text, "Niets doen" series.', ratio: '7,5:1' },
  { name: 'Ink 500', token: '--ink-500', hex: '#56666d', role: 'Footnotes, sources, axis labels.', ratio: '5,6:1' },
  { name: 'June Green strong', token: '--accent-strong', hex: '#127a71', role: 'The ONE CTA colour, links, small green text, "Met June" series.', ratio: '5,2:1 · wit erop 5,2:1' },
  { name: 'Logo green', token: '--accent', hex: '#1ca498', role: 'Logo, fills, icons, large display. Never small text.', ratio: '2,9:1 (graphic)' },
  { name: 'Mint soft', token: '--accent-soft', hex: '#e3f4f2', role: 'June column wash, highlight.', ratio: 'ink 14,1:1' },
  { name: 'June Red', token: '--spark', hex: '#e85257', role: 'ONE annotation per page: the squiggle.', ratio: '3,4:1 (graphic)' },
  { name: 'June Red text', token: '--spark-text', hex: '#c4383e', role: 'Annotation label "De prijs van trouw", form errors.', ratio: '4,95:1' },
];
const icons = ['arrow-r', 'check-circle', 'shield', 'plug', 'repeat', 'info', 'user', 'ext', 'plus'] as const;
---
<Page locale="nl-be" routeKey="style-tile" title="Stijltegel · June variant C · Honest Market" description="Style tile voor concept C, Honest Market: palet, typografie, componenten, grafiekstijl, motief en beweging." noindex>
  <main id="inhoud" class="tile">
    <header class="wrap tile-head">
      <Logo href="/nl-be/" label="June" size="lg" />
      <p class="kicker"><span class="kicker-n">C</span><span>Style tile · concept stage · Honest Market</span></p>
      <h1>De energiemarkt is ingewikkeld gemaakt. <span class="h1-turn">Wij niet.</span></h1>
      <p class="lead">Een redactionele site: papier, inkt, een smalle leeskolom, voetnoten en bronnen. June Green voor data en de ene knop. June Red voor precies één aantekening. Merkvolume 3/10.</p>
      <ul class="tile-meta">
        <li><strong>Persona</strong> Scepticus / onderzoeker, 45+, vaak FR</li>
        <li><strong>Heldobject</strong> Geannoteerde marktgrafiek</li>
        <li><strong>Mechanisme</strong> Het grootste bezwaar wegnemen: wie betaalt June?</li>
        <li><strong>Signatuur</strong> De grafiek tekent zichzelf, de krul omcirkelt het verschil</li>
      </ul>
    </header>

    <section class="wrap tile-sec" aria-labelledby="t-pal">
      <p class="kicker"><span class="kicker-n">01</span><span id="t-pal">Palet · contrast op Paper</span></p>
      <div class="swatches">
        {swatches.map((s) => (
          <div class="sw">
            <span class="sw-chip" style={`background:${s.hex}`}></span>
            <strong>{s.name}</strong>
            <code>{s.token} · {s.hex}</code>
            <span class="note">{s.role}</span>
            <span class="sw-ratio">{s.ratio}</span>
          </div>
        ))}
      </div>
      <p class="note" style="margin-top:16px;">Energiekleuren (elek #f0b429, gas #1f86c4) enkel in grafieken over dat energietype. Donkere modus volgt de app-tokens (paper wordt #0d171a).</p>
    </section>

    <section class="wrap tile-sec" aria-labelledby="t-type">
      <p class="kicker"><span class="kicker-n">02</span><span id="t-type">Redactionele typeschaal · Montserrat 600/700 + Inter 400–600</span></p>
      <div class="type-grid">
        <div>
          <p class="type-label">Display 68/1.06 · Montserrat 600 · −2%</p>
          <p class="type-h1">Wij niet.</p>
          <p class="type-label">H2 40 · Montserrat 600</p>
          <p class="type-h2">Wie betaalt June? Jij.</p>
          <p class="type-label">H3 22 · Montserrat 600</p>
          <p class="type-h3">Prijzen bewegen, ook als jij stilzit.</p>
          <p class="type-label">Kicker 13 · Inter 600 caps +8%</p>
          <p class="kicker"><span class="kicker-n">03</span><span>Het verdienmodel</span></p>
        </div>
        <div>
          <p class="type-label">Lead 21/1.5 · Inter 400 · ink 700</p>
          <p class="lead">June is geen leverancier. Jij betaalt ons, dus wij werken voor jou.</p>
          <p class="type-label">Leeskolom 18/1.6 · max 62 tekens</p>
          <div class="prose"><p>Leveranciers passen hun tarieven regelmatig aan. Welk contract voordelig is, verandert dus mee. Wat vorig jaar een goede keuze was, is dat vandaag niet per se nog.<Fn n={1} L="nl" /></p></div>
          <p class="type-label">Pull-quote 36/1.2 · Montserrat 600</p>
          <figure class="pull pull--tile"><span class="pull-mark" aria-hidden="true">“</span><blockquote><p>Eén keer vergelijken is een foto. De markt is een film.</p></blockquote></figure>
          <p class="type-label">Voetnoot 13/1.5 · ink 500</p>
          <p class="note">¹ Gemiddelde besparing per klant per jaar, berekend door June op [periode] over [aantal] klanten.</p>
          <p class="type-label">Bron 13 · Inter 600 caps-tag + tekst</p>
          <p class="note"><span class="tag">Illustratief</span> Bron vóór livegang: tariefdata CREG / VREG.</p>
        </div>
      </div>
    </section>

    <section class="wrap tile-sec" aria-labelledby="t-ui">
      <p class="kicker"><span class="kicker-n">03</span><span id="t-ui">Knoppen, velden, labels</span></p>
      <div class="ui-grid">
        <div class="ui-row">
          <a class="btn" href="/nl-be/aanmelden/">Bereken je besparing<Icon name="arrow-r" /></a>
          <a class="btn btn--sm" href="/nl-be/aanmelden/">Bereken je besparing</a>
          <a class="btn btn--ghost" href="#t-ui">Hoe werkt het?</a>
          <a href="#t-ui">Tekstlink</a>
          <span class="tag">Illustratief</span>
          <span class="tag">placeholder</span>
        </div>
        <PostcodeForm locale="nl-be" c={c} id="tile" />
        <div class="field" style="max-width: 200px;">
          <label for="pc-err">Foutstatus</label>
          <input class="input" id="pc-err" value="90" aria-invalid="true" aria-describedby="pc-err-h" />
          <p class="pc-help is-error" id="pc-err-h">Vul een Belgische postcode in van 4 cijfers, bv. 9000.</p>
        </div>
        <Trust c={c} id="tile" />
      </div>
    </section>

    <section class="wrap tile-sec tile-2col" aria-labelledby="t-chart">
      <div>
        <p class="kicker"><span class="kicker-n">04</span><span id="t-chart">Grafiekstijl</span></p>
        <ul class="rules">
          <li>Directe labels aan het einde van elke lijn, nooit een legendebox.</li>
          <li>Ink 700 = de markt / niets doen. June Green strong = June. Energiekleuren enkel per energietype.</li>
          <li>Rasterlijnen ink 100, geen getallen op de y-as als de data illustratief is.</li>
          <li>Altijd: titel als vraag of stelling, label “Illustratief”, methode en bron eronder.</li>
          <li>Lijn 3px, ronde uiteinden. Punten = momenten waarop June wisselt.</li>
          <li>Tekst ≥ 13px in het SVG-raster.</li>
        </ul>
      </div>
      <MarketChart c={c} id="tile-chart" />
    </section>

    <section class="wrap tile-sec tile-2col" aria-labelledby="t-motif">
      <div>
        <p class="kicker"><span class="kicker-n">05</span><span id="t-motif">Iconen en motief</span></p>
        <div class="icons">{icons.map((n) => <span class="ic"><Icon name={n} /></span>)}</div>
        <p class="note" style="margin-top:12px;">Lijniconen 24px, 1,75 lijn, ronde uiteinden, zelfde familie als de app. Groen alleen als ze iets bevestigen.</p>
      </div>
      <div>
        <svg class="motif-demo" viewBox="0 0 320 120" role="img" aria-label="Voorbeeld van de krul: een handgetekende lus rond één getal">
          <text x="160" y="70" text-anchor="middle" class="md-num">€ 99</text>
          <path class="squiggle-demo" d="M232 58 C230 34 190 26 160 28 C120 30 94 44 96 64 C98 86 132 96 166 94 C204 92 236 80 232 56 C230 44 218 36 206 34" />
        </svg>
        <ul class="rules">
          <li><strong>Krul = aantekening.</strong> Handgetekende lus rond één getal of één kloof. Lijn 2,25px, June Red.</li>
          <li>Maximaal één per pagina, altijd samen met een tekstlabel. Geen blobs, geen halftoon, geen Junior in dit concept.</li>
        </ul>
      </div>
    </section>

    <section class="wrap tile-sec" aria-labelledby="t-motion">
      <p class="kicker"><span class="kicker-n">06</span><span id="t-motion">Beweging</span></p>
      <ol class="rules rules--num">
        <li><strong>Signatuur: de grafiek tekent zichzelf.</strong> Bij het in beeld komen: lijnen 700ms (ease-out, geen overshoot), June-lijn 160ms later, dan labels en punten; na 900ms omcirkelt de krul het verschil (560ms). Eén keer.</li>
        <li><strong>De rest is drukwerk.</strong> Secundaire blokken: 12px opschuiven + fade, 480ms, één keer. H1, lead en formulier bewegen nooit en starten nooit op opacity 0.</li>
        <li><strong>Zonder JS of met reduced motion</strong> staat alles meteen volledig getekend. Geen scroll-jacking, geen parallax.</li>
        <li><strong>Mobiel:</strong> sticky balk met de ene CTA schuift in (240ms) zodra het postcodeveld uit beeld is, en verdwijnt bij het tweede formulier en de footer.</li>
      </ol>
    </section>

    <section class="section" aria-labelledby="t-sample">
      <div class="wrap">
        <div class="section-head">
          <p class="kicker"><span class="kicker-n">07</span><span>Voorbeeldsectie</span></p>
          <h2 id="t-sample">Wie betaalt June? Jij. En dat is precies de bedoeling.</h2>
          <div class="prose"><p><strong>June leeft van de abonnementen van haar klanten.</strong><Fn n={5} L="nl" /> We zijn geen energieleverancier en kiezen je contract op basis van jouw verbruik.</p></div>
        </div>
        <ol class="facts">
          {howCopy('nl-be').market.facts.map((f, i) => <li><span class="fact-n" aria-hidden="true">{i + 1}</span><h3>{f.h}</h3><p>{f.p}</p></li>)}
        </ol>
      </div>
    </section>
    <footer class="wrap footer" style="padding-bottom:48px">
      <ol class="footnotes">{c.footnotes.map((f) => <li id={f.id}>{f.text}</li>)}</ol>
    </footer>
  </main>
</Page>

<style>
  .tile-head { padding-block: 48px 56px; display: grid; gap: 24px; }
  .tile-head h1 { font-size: var(--fs-h1); max-width: 16ch; }
  .tile-head .h1-turn { color: var(--accent-strong); }
  .tile-meta { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--rule-strong); font-size: 15px; color: var(--ink-700); }
  .tile-meta li { padding: 14px 16px 0 0; }
  .tile-meta strong { display: block; font-size: 12px; letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--ink-500); }
  .tile-sec { padding-block: 48px; border-top: 1px solid var(--rule); display: grid; gap: 24px; }
  .tile-2col { grid-template-columns: 1fr 1.2fr; gap: 48px; align-items: start; }
  .swatches { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; }
  .sw { display: grid; gap: 4px; align-content: start; font-size: 14px; }
  .sw-chip { height: 72px; border-radius: 8px; box-shadow: inset 0 0 0 1px rgba(20,35,42,.14); }
  .sw code { font-size: 12px; color: var(--ink-700); }
  .sw-ratio { font-family: var(--font-display); font-weight: 600; font-size: 14px; }
  .type-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .type-label { font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-500); margin: 24px 0 8px; border-top: 1px solid var(--rule); padding-top: 8px; }
  .type-h1 { font-family: var(--font-display); font-weight: 600; font-size: 68px; line-height: 1.06; letter-spacing: -0.02em; color: var(--accent-strong); }
  .type-h2 { font-family: var(--font-display); font-weight: 600; font-size: 40px; line-height: 1.1; letter-spacing: -0.02em; }
  .type-h3 { font-family: var(--font-display); font-weight: 600; font-size: 22px; line-height: 1.2; }
  .pull--tile { margin: 0; grid-template-columns: 56px 1fr; }
  .pull--tile .pull-mark { font-size: 72px; }
  .ui-grid { display: grid; gap: 28px; }
  .ui-row { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; }
  .rules { margin: 16px 0 0; padding-left: 1.1em; display: grid; gap: 8px; font-size: 16px; color: var(--ink-700); max-width: 60ch; }
  .rules--num { padding-left: 1.4em; }
  .icons { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 16px; }
  .ic { width: 48px; height: 48px; display: grid; place-items: center; border: 1px solid var(--rule); border-radius: 10px; background: var(--surface); color: var(--ink-900); }
  .ic svg { width: 24px; height: 24px; }
  .motif-demo { width: 100%; max-width: 360px; }
  .md-num { font-family: var(--font-display); font-weight: 700; font-size: 34px; fill: var(--ink-900); }
  .squiggle-demo { fill: none; stroke: var(--spark); stroke-width: 2.25; stroke-linecap: round; }
  @media (max-width: 860px) {
    .tile-meta, .type-grid, .tile-2col { grid-template-columns: 1fr; }
    .swatches { grid-template-columns: repeat(2, 1fr); }
  }
</style>
