---
// Page shell for content pages: Base + icon sprite + header + <main> + footer + sticky mobile CTA.
import { href } from '@shared/routes.mjs';
import Base from '../layouts/Base.astro';
import Icons from './Icons.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Sticky from './Sticky.astro';
import { copy } from '../content/home';
import type { Locale } from '../lib/estimate';
interface Props { locale: Locale; routeKey: string; title: string; description: string; graph?: object[]; crumbs?: [string, string][]; sticky?: boolean; stickyHref?: string; }
const { locale, routeKey, title, description, graph, crumbs, sticky = true, stickyHref } = Astro.props;
const c = copy(locale);
const base = import.meta.env.BASE_URL;
---
<Base locale={locale} routeKey={routeKey} title={title} description={description} graph={graph} crumbs={crumbs}>
  <Icons />
  <Header locale={locale} routeKey={routeKey} />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer locale={locale} />
  {sticky && <Sticky label={c.nav.cta} href={stickyHref ?? href('signup', locale, base)} proof={c.sticky.proof} starsLabel={c.hero.starsLabel} />}
  <slot name="after" />
</Base>
