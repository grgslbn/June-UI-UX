---
// Sticky mobile CTA (≤ 900px): appears once [data-sticky-after] (the hero) has scrolled out of view and hides
// while the final CTA or the footer is on screen. ≤ 64px, safe-area aware. `inert` while hidden.
import Stars from './Stars.astro';
interface Props { label: string; href: string; proof: string; starsLabel: string; cta?: string; }
const { label, href, proof, starsLabel, cta = 'sticky' } = Astro.props;
---
<div class="sticky" data-sticky data-on="false" inert>
  <div class="sticky-in">
    <p class="sticky-t"><span data-sticky-num></span><span class="sticky-proof"><Stars label={starsLabel} size={12} /> {proof}</span></p>
    <a class="btn btn--sm" href={href} data-cta={cta}>{label}</a>
  </div>
</div>
<script>
  const sticky = document.querySelector<HTMLElement>('[data-sticky]');
  const after = document.querySelector('[data-sticky-after]');
  if (sticky && after) {
    let past = false; const inView = new Set<Element>();
    const upd = () => { const on = past && inView.size === 0; sticky.dataset.on = String(on); sticky.inert = !on; };
    new IntersectionObserver(([en]) => { past = !en.isIntersecting && en.boundingClientRect.top < 0; upd(); }).observe(after);
    const io = new IntersectionObserver(ens => { for (const en of ens) en.isIntersecting ? inView.add(en.target) : inView.delete(en.target); upd(); });
    document.querySelectorAll('[data-final], [data-footer]').forEach(el => io.observe(el));
    // hide while the on-screen keyboard is likely open
    document.addEventListener('focusin', e => { if ((e.target as HTMLElement).matches('input, textarea, select')) { sticky.dataset.on = 'false'; sticky.inert = true; } });
    document.addEventListener('focusout', () => setTimeout(upd, 50));
    upd();
  }
</script>
<style>
  .sticky { display: none; }
  @media (max-width: 900px) {
    .sticky { display: block; position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; padding: 8px var(--gutter) calc(8px + env(safe-area-inset-bottom)); background: rgba(255,255,255,.97);
      box-shadow: 0 -1px 0 var(--hairline), 0 -10px 30px -12px rgba(20,35,42,.25); transform: translateY(110%); visibility: hidden; transition: transform var(--dur-base) var(--ease-out), visibility 0s linear var(--dur-base); }
    .sticky[data-on="true"] { transform: none; visibility: visible; transition: transform var(--dur-base) var(--ease-out), visibility 0s; }
    .sticky-in { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); }
    .sticky-t { display: grid; gap: 2px; font-size: var(--fs-12); line-height: 1.3; min-width: 0; }
    .sticky-t [data-sticky-num] { font: 700 var(--fs-16)/1.2 var(--font-display); }
    .sticky-t [data-sticky-num]:empty { display: none; }
    .sticky-proof { display: flex; align-items: center; gap: 6px; color: var(--ink-700); }
    .sticky .btn { min-height: 48px; flex: none; }
  }
</style>
