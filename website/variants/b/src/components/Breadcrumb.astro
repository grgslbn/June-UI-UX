---
import { href } from '@shared/routes.mjs';
import type { Locale } from '../lib/estimate';
interface Props { locale: Locale; trail: [string, string][]; }
const { locale, trail } = Astro.props;
const base = import.meta.env.BASE_URL;
const fr = locale === 'fr-be';
---
<nav class="crumbs" aria-label={fr ? 'Fil d’Ariane' : 'Kruimelpad'}>
  <ol role="list">
    <li><a href={href('home', locale, base)}>June</a></li>
    {trail.map(([name, key], i) => (
      <li>{i === trail.length - 1 ? <span aria-current="page">{name}</span> : <a href={href(key, locale, base)}>{name}</a>}</li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 4px; font-size: var(--fs-14); color: var(--ink-500); }
  .crumbs li { display: inline-flex; align-items: center; gap: 4px; }
  .crumbs li + li::before { content: "/"; color: var(--ink-200); margin-right: 2px; }
  .crumbs a { color: var(--ink-700); text-decoration: none; min-height: 24px; display: inline-flex; align-items: center; }
  .crumbs a:hover { text-decoration: underline; color: var(--accent-strong); }
  .crumbs [aria-current] { color: var(--ink-900); font-weight: 600; }
</style>
