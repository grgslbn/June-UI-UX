---
// Partial stars: 4,3/5 renders as 4 full + ~30% (never 5 full). Decorative, labelled for AT.
interface Props { label: string; value?: number; size?: number; tone?: 'light' | 'ink'; }
const { label, value = 4.3, size = 16, tone = 'light' } = Astro.props;
const star = 'M8 .8l2.2 4.6 5 .6-3.7 3.5.9 5-4.4-2.4-4.4 2.4.9-5L.8 6l5-.6z';
const w = size * 5.5;
const pct = (() => { const full = Math.floor(value); const frac = value - full; return ((full * 18 + frac * 16) / 88) * 100; })();
---
<span class="stars" role="img" aria-label={label} style={`width:${w}px;height:${size}px`}>
  <svg viewBox="0 0 88 16" aria-hidden="true" style={`width:${w}px;height:${size}px`}><g fill={tone === 'ink' ? 'rgba(255,255,255,.22)' : '#c9d3d5'}>{[0,1,2,3,4].map(i => <path transform={`translate(${i*18} 0)`} d={star} />)}</g></svg>
  <span class="fill" style={`width:${pct.toFixed(1)}%`}><svg viewBox="0 0 88 16" aria-hidden="true" style={`width:${w}px;height:${size}px`}><g fill="#f0b429">{[0,1,2,3,4].map(i => <path transform={`translate(${i*18} 0)`} d={star} />)}</g></svg></span>
</span>
