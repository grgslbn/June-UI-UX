---
// Concept B · Savings First — homepage. Section rhythm: number → how we get it → what it costs → who says so.
import { href } from '@shared/routes.mjs';
import Base from '../layouts/Base.astro';
import Icons from './Icons.astro';
import Header from './Header.astro';
import Calculator from './Calculator.astro';
import Footer from './Footer.astro';
import Stars from './Stars.astro';
import { copy } from '../content/home';
import { eur, eurRange, estimate, type Locale } from '../lib/estimate';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const base = import.meta.env.BASE_URL;
const c = copy(locale);
const fr = locale === 'fr-be';
const fnLabel = (n: number) => (fr ? `Note ${n}` : `Voetnoot ${n}`);
const signup = href('signup', locale, base);
const termIcons = ['gauge', 'scale', 'wallet', 'repeat'];
const ops = ['×', '−', '='];
const ex = estimate({ housing: 'terraced', energy: 'both' });
---
<Base locale={locale} routeKey="home" title={c.meta.title} description={c.meta.description}>
  <Icons />
  <Header locale={locale} routeKey="home" />
  <main id="main" tabindex="-1">
    <Calculator locale={locale} />

    <!-- proof strip: the numbers, each with its footnote -->
    <section class="proof" aria-label={fr ? 'June en chiffres' : 'June in cijfers'}>
      <div class="wrap">
        <ul role="list" class="proof-list">
          {c.proof.map(p => (
            <li>
              <p class="proof-v num">{p.value}{p.fn && <sup><a href={`#fn-${p.fn}`} aria-label={fnLabel(p.fn)}>{p.fn}</a></sup>}</p>
              <p class="proof-l">{p.stars && <Stars label={c.hero.starsLabel} size={14} />}{p.label}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 1 · how we get your number -->
    <section class="section section--mint method" id="methode" aria-labelledby="method-h">
      <div class="wrap">
        <div class="section-head reveal">
          <p class="eyebrow">{c.method.eyebrow}</p>
          <h2 id="method-h">{c.method.h2}</h2>
          <p>{c.method.intro}</p>
        </div>
        <ol class="eq reveal" role="list">
          {c.method.terms.map((x, i) => (
            <>
              <li class:list={['eq-t', { 'eq-t--you': i === 3 }]}>
                <span class="well"><svg class="i" aria-hidden="true"><use href={`#i-${termIcons[i]}`} /></svg></span>
                <span class="eq-k">{x.k}</span>
                <span class="eq-v">{x.v}</span>
                {i === 3 && <span class="eq-num num" data-eq-num>≈ {eurRange(ex.net[0], ex.net[1], locale)}</span>}
              </li>
              {i < 3 && <li class="eq-op" aria-hidden="true">{ops[i]}</li>}
            </>
          ))}
        </ol>
        <div class="steps-wrap">
          <h3 class="steps-h">{c.method.stepsTitle}</h3>
          <ol class="steps" role="list">
            {c.steps.map(s => (
              <li class="step reveal">
                <span class="step-n num" aria-hidden="true">{String(s.n).padStart(2, '0')}</span>
                <h4>{s.title}</h4>
                <p>{s.body}</p>
              </li>
            ))}
          </ol>
          <div class="method-foot">
            <p class="small muted">{c.method.suppliers}</p>
            <a class="link-arrow" href={href('howItWorks', locale, base)}>{c.method.more}<svg class="i" aria-hidden="true"><use href="#i-arrow" /></svg></a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2 · what June costs: yearly totals first -->
    <section class="section plans" id="prijzen" aria-labelledby="plans-h">
      <div class="wrap">
        <div class="section-head reveal">
          <p class="eyebrow">{c.plans.eyebrow}</p>
          <h2 id="plans-h">{c.plans.h2}</h2>
          <p>{c.plans.intro}</p>
        </div>
        <ul role="list" class="cards">
          {c.plans.cards.map(p => (
            <li class:list={['card reveal', { 'card--rec': p.rec }]}>
              {p.rec && <p class="card-badge"><svg class="i" aria-hidden="true"><use href="#i-shield" /></svg>{c.plans.badge}</p>}
              <div class="card-body">
                <h3 class="card-name">{p.name}</h3>
                <p class="card-who">{p.who}</p>
                <p class="card-price"><span class="num">{eur(p.yearly, locale)}</span> <span class="card-per">{c.plans.perYear}</span></p>
                <p class="card-sub">{p.sub}<sup><a href="#fn-5" aria-label={fnLabel(5)}>5</a></sup></p>
                <ul role="list" class="feat">
                  {p.features.map(f => <li><svg class="i" aria-hidden="true"><use href="#i-check" /></svg><span>{f}</span></li>)}
                </ul>
                {p.rec && (
                  <div class="ex">
                    <p class="ex-t">{c.plans.example.t}</p>
                    <p>{c.plans.example.b}<sup><a href="#fn-4" aria-label={fnLabel(4)}>4</a></sup></p>
                  </div>
                )}
                {p.slug === 'premium' && <p class="req"><svg class="i" aria-hidden="true"><use href="#i-info" /></svg>{c.plans.requirement}</p>}
                <a class:list={['btn btn--block', p.rec ? '' : 'btn--ghost']} href={`${signup}?plan=${p.slug}`}>{p.cta}</a>
              </div>
            </li>
          ))}
        </ul>
        <div class="plans-foot">
          <p class="fine">{c.plans.footnote}</p>
          <a class="link-arrow" href={href('plans', locale, base)}>{c.plans.compare}<svg class="i" aria-hidden="true"><use href="#i-arrow" /></svg></a>
        </div>
      </div>
    </section>

    <!-- 3 · who says so: reviews + independence (ink band) -->
    <section class="section section--ink trust-band on-ink" id="reviews" aria-labelledby="trust-h">
      <div class="wrap">
        <div class="tb-top">
          <div class="tb-rating reveal">
            <p class="eyebrow">{c.trust.eyebrow}</p>
            <h2 id="trust-h">{c.trust.h2}</h2>
            <div class="tb-score">
              <p class="tb-num num">4,3</p>
              <div>
                <Stars label={c.hero.starsLabel} size={20} tone="ink" />
                <p class="tb-line">{c.trust.ratingLine}<sup><a href="#fn-2" aria-label={fnLabel(2)}>2</a></sup></p>
              </div>
            </div>
          </div>
          <ul role="list" class="tb-points">
            {c.trust.points.map((p, i) => (
              <li class="reveal">
                <span class="tb-ic"><svg class="i" aria-hidden="true"><use href={`#i-${['plug', 'wallet', 'hand'][i]}`} /></svg></span>
                <div>
                  <h3>{p.t} {p.flag && <span class="chip chip--placeholder">{p.flag}</span>}</h3>
                  <p>{p.b}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
        <p class="tb-label">{c.trust.reviewsLabel}</p>
        <ul role="list" class="reviews">
          {[1, 2, 3].map(n => (
            <li class="review" data-placeholder="review">
              <span class="chip chip--placeholder">placeholder</span>
              <Stars label={c.hero.starsLabel} size={14} tone="ink" />
              <span class="skel" aria-hidden="true"><i></i><i></i><i></i></span>
              <p class="review-note">{c.trust.reviewSlot}</p>
            </li>
          ))}
          <li class="review review--photo">
            <img src={`${base.replace(/\/?$/, '/')}img/placeholder-photo-home.svg`} alt={c.trust.photoAlt} width="400" height="500" loading="lazy" decoding="async" />
          </li>
        </ul>
      </div>
    </section>

    <!-- 4 · FAQ (native details, exclusive accordion) -->
    <section class="section faq" id="faq" aria-labelledby="faq-h">
      <div class="wrap faq-grid">
        <div class="section-head">
          <p class="eyebrow">{c.faq.eyebrow}</p>
          <h2 id="faq-h">{c.faq.h2}</h2>
          <a class="link-arrow" href={href('faq', locale, base)}>{c.faq.more}<svg class="i" aria-hidden="true"><use href="#i-arrow" /></svg></a>
        </div>
        <div class="qa">
          {c.faq.items.map(q => (
            <details name="faq" id={`faq-${q.id}`}>
              <summary><h3>{q.q}</h3><svg class="i" aria-hidden="true"><use href="#i-chevron" /></svg></summary>
              <p>{q.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- final CTA -->
    <section class="section section--mint final" data-final aria-labelledby="final-h">
      <div class="wrap final-in">
        <h2 id="final-h">{c.final.h2}</h2>
        <p>{c.final.body}</p>
        <a class="btn btn--lg" href="#bereken">{c.final.cta}<svg class="i" aria-hidden="true"><use href="#i-arrow" /></svg></a>
        <p class="final-proof"><Stars label={c.hero.starsLabel} size={14} /> {c.sticky.proof} · {c.guarantee}<sup><a href="#fn-4" aria-label={fnLabel(4)}>4</a></sup></p>
      </div>
    </section>
  </main>
  <Footer locale={locale} />

  <!-- sticky mobile CTA (appears once the calculator is out of view; shows your number once you have one) -->
  <div class="sticky" data-sticky data-on="false" inert>
    <div class="sticky-in">
      <p class="sticky-t"><span data-sticky-num></span><span class="sticky-proof">★ {c.sticky.proof}</span></p>
      <a class="btn btn--sm" href="#bereken">{c.nav.cta}</a>
    </div>
  </div>
</Base>

<style>
  /* proof strip */
  .proof { border-bottom: 1px solid var(--hairline); }
  .proof-list { display: grid; grid-template-columns: repeat(4, 1fr); }
  .proof-list li { padding: var(--s-8) var(--s-6); border-left: 1px solid var(--hairline); }
  .proof-list li:first-child { border-left: 0; padding-left: 0; }
  .proof-v { font-size: var(--fs-48); font-weight: 700; line-height: 1; }
  .proof-v sup a { color: var(--ink-500); font-family: var(--font-ui); letter-spacing: 0; }
  .proof-l { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 10px; font-size: var(--fs-14); color: var(--ink-700); }

  /* method: the equation */
  .eq { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr auto 1.1fr; align-items: stretch; gap: var(--s-3); padding: 0; }
  .eq-t { display: grid; align-content: start; gap: 6px; padding: var(--s-6); background: var(--surface); border-radius: var(--r-lg); box-shadow: var(--shadow-1); }
  .eq-t .well { margin-bottom: var(--s-3); }
  .eq-k { font: 700 var(--fs-22)/1.25 var(--font-display); }
  .eq-v { font-size: var(--fs-14); color: var(--ink-500); }
  .eq-t--you { background: var(--ink-900); color: var(--on-ink); }
  .eq-t--you .well { background: rgba(59,173,168,.18); color: var(--accent); }
  .eq-t--you .eq-v { color: var(--on-ink-muted); }
  .eq-num { margin-top: var(--s-2); font-size: var(--fs-32); font-weight: 700; line-height: 1; color: var(--accent); white-space: nowrap; }
  .eq-op { display: grid; place-items: center; font: 600 var(--fs-48)/1 var(--font-display); color: var(--accent-strong); min-width: 28px; }
  .steps-wrap { margin-top: var(--s-16); padding-top: var(--s-10); border-top: 1px solid var(--hairline-strong); }
  .steps-h { font-size: var(--fs-22); margin-bottom: var(--s-6); }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-10); }
  .step { display: grid; gap: var(--s-2); align-content: start; }
  .step-n { font-size: var(--fs-48); font-weight: 700; line-height: 1; color: transparent; -webkit-text-stroke: 1.5px var(--accent-strong); margin-bottom: var(--s-2); }
  .step h4 { font: 700 var(--fs-18)/1.3 var(--font-display); }
  .step p { font-size: var(--fs-16); color: var(--ink-700); }
  .method-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--s-4); margin-top: var(--s-10); }
  .method-foot .small { max-width: 64ch; }

  /* plans */
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-6); align-items: stretch; }
  .card { display: flex; flex-direction: column; border-radius: var(--r-lg); background: var(--surface); box-shadow: inset 0 0 0 1px var(--hairline-strong); }
  .card-body { display: flex; flex-direction: column; gap: var(--s-3); padding: var(--s-8); flex: 1; }
  .card--rec { box-shadow: inset 0 0 0 2px var(--ink-900), var(--shadow-2); }
  .card-badge { display: flex; align-items: center; gap: 8px; padding: 12px var(--s-8); border-radius: var(--r-lg) var(--r-lg) 0 0; background: var(--ink-900); color: #fff; font-size: var(--fs-14); font-weight: 600; }
  .card-badge .i { width: 18px; height: 18px; color: var(--accent); }
  .card-name { font-size: var(--fs-32); }
  .card-who { font-size: var(--fs-16); color: var(--ink-700); min-height: 3em; }
  .card-price { margin-top: var(--s-2); display: flex; align-items: baseline; gap: 8px; }
  .card-price .num { font-size: clamp(2.5rem, 1.6rem + 2.2vw, 3.5rem); font-weight: 700; line-height: 1; }
  .card-per { font-size: var(--fs-16); font-weight: 600; color: var(--ink-700); }
  .card-sub { font-size: var(--fs-14); color: var(--ink-500); padding-bottom: var(--s-4); border-bottom: 1px solid var(--hairline); }
  .feat { display: grid; gap: 10px; margin-top: var(--s-2); font-size: var(--fs-16); }
  .feat li { display: flex; gap: 10px; align-items: flex-start; }
  .feat .i { width: 20px; height: 20px; color: var(--accent-strong); flex: none; margin-top: 2px; }
  .ex { margin-top: var(--s-2); padding: 14px 16px; border-radius: var(--r-md); background: var(--accent-soft); font-size: var(--fs-14); color: var(--ink-900); }
  .ex-t { font-weight: 700; margin-bottom: 2px; }
  .req { display: flex; gap: 8px; align-items: flex-start; font-size: var(--fs-14); color: var(--ink-700); }
  .req .i { width: 18px; height: 18px; flex: none; color: var(--ink-500); margin-top: 1px; }
  .card .btn { margin-top: auto; }
  .card-body > .btn { margin-top: auto; }
  .card-body > :nth-last-child(2) { margin-bottom: var(--s-3); }
  .plans-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--s-4); margin-top: var(--s-8); }

  /* trust band */
  .tb-top { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-16); align-items: start; }
  .tb-rating { display: grid; gap: var(--s-4); }
  .tb-score { display: flex; align-items: center; gap: var(--s-6); margin-top: var(--s-4); }
  .tb-num { font-size: clamp(5rem, 3rem + 6vw, 8.5rem); font-weight: 700; line-height: .9; color: #fff; }
  .tb-line { margin-top: 8px; font-size: var(--fs-16); color: var(--on-ink-muted); }
  .tb-line sup a, .reviews sup a { color: var(--accent); }
  .tb-points { display: grid; gap: var(--s-6); padding-top: var(--s-2); }
  .tb-points li { display: flex; gap: var(--s-4); padding-bottom: var(--s-6); border-bottom: 1px solid var(--on-ink-faint); }
  .tb-points li:last-child { border-bottom: 0; }
  .tb-ic { display: grid; place-items: center; width: 48px; height: 48px; border-radius: var(--r-md); background: rgba(59,173,168,.16); color: var(--accent); flex: none; }
  .tb-points h3 { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .tb-points p { margin-top: 4px; color: var(--on-ink-muted); font-size: var(--fs-16); }
  .tb-label { margin-top: var(--s-16); margin-bottom: var(--s-4); font-size: var(--fs-14); font-weight: 600; color: var(--on-ink-muted); }
  .reviews { display: grid; grid-template-columns: repeat(3, 1fr) .9fr; gap: var(--s-4); }
  .review { display: grid; align-content: start; gap: var(--s-3); padding: var(--s-6); border-radius: var(--r-lg); background: var(--ink-800); box-shadow: inset 0 0 0 1px var(--on-ink-faint); }
  .review .chip { justify-self: start; }
  .reviews { align-items: start; }
  .skel { display: grid; gap: 8px; }
  .skel i { display: block; height: 10px; border-radius: 6px; background: rgba(255,255,255,.1); }
  .skel i:nth-child(2) { width: 88%; } .skel i:nth-child(3) { width: 60%; }
  .review-note { font-size: var(--fs-14); color: var(--on-ink-muted); }
  .review--photo { padding: 0; overflow: hidden; background: var(--accent); aspect-ratio: 1; align-self: start; }
  .review--photo img { width: 100%; height: 100%; object-fit: cover; }

  /* FAQ */
  .faq-grid { display: grid; grid-template-columns: 5fr 7fr; gap: var(--s-16); align-items: start; }
  .faq .section-head { margin-bottom: 0; position: sticky; top: calc(var(--header-h) + 32px); }
  .qa { border-top: 1px solid var(--hairline-strong); }
  .qa details { border-bottom: 1px solid var(--hairline-strong); }
  .qa summary { display: flex; justify-content: space-between; align-items: center; gap: var(--s-4); min-height: 64px; padding: var(--s-4) 0; cursor: pointer; list-style: none; }
  .qa summary::-webkit-details-marker { display: none; }
  .qa summary h3 { font-size: var(--fs-18); font-weight: 600; }
  .qa summary .i { flex: none; color: var(--accent-strong); transition: transform var(--dur-base) var(--ease-out); }
  .qa details[open] summary .i { transform: rotate(180deg); }
  .qa summary:hover h3 { color: var(--accent-strong); }
  .qa details p { padding: 0 var(--s-10) var(--s-6) 0; color: var(--ink-700); max-width: 60ch; }

  /* final */
  .final-in { display: grid; justify-items: center; text-align: center; gap: var(--s-4); }
  .final-in p { color: var(--ink-700); }
  .final-in .btn { margin-top: var(--s-2); }
  .final-proof { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 8px; font-size: var(--fs-14); }

  /* sticky mobile CTA */
  .sticky { display: none; }
  @media (max-width: 900px) {
    .sticky { display: block; position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom)); background: rgba(255,255,255,.97);
      box-shadow: 0 -1px 0 var(--hairline), 0 -10px 30px -12px rgba(20,35,42,.25); transform: translateY(110%); visibility: hidden; transition: transform var(--dur-base) var(--ease-out), visibility 0s linear var(--dur-base); }
    .sticky[data-on="true"] { transform: none; visibility: visible; transition: transform var(--dur-base) var(--ease-out), visibility 0s; }
    .sticky-in { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); }
    .sticky-t { display: grid; font-size: var(--fs-14); line-height: 1.3; }
    .sticky-t [data-sticky-num] { font: 700 var(--fs-16)/1.2 var(--font-display); }
    .sticky-t [data-sticky-num]:empty { display: none; }
    .sticky-proof { color: var(--ink-700); }
    .sticky .btn { min-height: 48px; }
  }

  @media (max-width: 1080px) {
    .eq { grid-template-columns: 1fr auto 1fr; }
    .eq-op:nth-child(4) { display: none; }
    .reviews { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 900px) {
    .proof-list { grid-template-columns: repeat(2, 1fr); }
    .proof-list li { padding: var(--s-6) var(--s-4); border-left: 0; border-top: 1px solid var(--hairline); }
    .proof-list li:nth-child(-n+2) { border-top: 0; }
    .proof-list li:nth-child(odd) { padding-left: 0; }
    .proof-list li:nth-child(even) { border-left: 1px solid var(--hairline); }
    .cards { grid-template-columns: 1fr; max-width: 560px; }
    .card--rec { order: -1; }
    .tb-top, .faq-grid { grid-template-columns: 1fr; gap: var(--s-10); }
    .faq .section-head { position: static; }
    .steps { grid-template-columns: 1fr; gap: var(--s-8); }
  }
  @media (max-width: 640px) {
    .eq { grid-template-columns: 1fr; gap: 6px; }
    .eq-op, .eq-op:nth-child(4) { display: grid; min-height: 28px; font-size: var(--fs-32); }
    .eq-t { grid-template-columns: auto 1fr; column-gap: var(--s-4); padding: var(--s-4) var(--s-5); }
    .eq-t .well { grid-row: span 2; margin: 0; }
    .eq-num { grid-column: 1 / -1; }
    .reviews { grid-template-columns: 1fr; }
    .review--photo { aspect-ratio: 16 / 10; }
    .proof-v { font-size: var(--fs-32); }
    .card-body { padding: var(--s-6); }
    .card-badge { padding-inline: var(--s-6); }
    .qa details p { padding-right: 0; }
  }
</style>
