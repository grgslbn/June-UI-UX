---
// Native <details> accordion (exclusive via name). Each item deep-linkable by id.
interface Item { id: string; q: string; a: string; }
interface Props { items: Item[]; group?: string; level?: 2 | 3; }
const { items, group = 'faq', level = 3 } = Astro.props;
const H = level === 2 ? 'h2' : 'h3';
---
<div class="qa">
  {items.map(q => (
    <details name={group} id={q.id} data-q>
      <summary><H class="qa-q">{q.q}</H><svg class="i" aria-hidden="true"><use href="#i-chevron" /></svg></summary>
      <div class="qa-a"><p set:html={q.a} /></div>
    </details>
  ))}
</div>
<script>
  // Deep links (#winstgarantie) open their answer; faq_open event (question id only).
  import { track } from '../lib/track';
  const open = () => { const id = decodeURIComponent(location.hash.slice(1)); const d = id && document.getElementById(id); if (d instanceof HTMLDetailsElement) { d.open = true; } };
  open(); addEventListener('hashchange', open);
  document.querySelectorAll<HTMLDetailsElement>('details[data-q]').forEach(d => d.addEventListener('toggle', () => { if (d.open) track('faq_open', { question_id: d.id }); }));
</script>
<style>
  .qa { border-top: 1px solid var(--hairline-strong); }
  .qa details { border-bottom: 1px solid var(--hairline-strong); scroll-margin-top: calc(var(--header-h) + 24px); }
  .qa summary { display: flex; justify-content: space-between; align-items: center; gap: var(--s-4); min-height: 64px; padding: var(--s-4) 0; cursor: pointer; list-style: none; }
  .qa summary::-webkit-details-marker { display: none; }
  .qa-q { font: 600 var(--fs-18)/1.35 var(--font-ui); letter-spacing: 0; }
  .qa summary .i { flex: none; color: var(--accent-strong); transition: transform var(--dur-base) var(--ease-out); }
  .qa details[open] summary .i { transform: rotate(180deg); }
  .qa summary:hover .qa-q { color: var(--accent-strong); }
  .qa-a { padding: 0 var(--s-10) var(--s-6) 0; color: var(--ink-700); max-width: 64ch; }
  @media (max-width: 640px) { .qa-a { padding-right: 0; } }
</style>
