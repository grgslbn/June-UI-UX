  .errsum-t { font-weight: 700; color: var(--red-text); }
  .errsum ul { margin: 6px 0 0; padding-left: 1.2em; font-size: var(--fs-14); }
  .errsum a { color: var(--red-text); font-weight: 600; }

  /* estimate card (same object as the home result card) */
  .res { position: relative; padding: clamp(22px, 3vw, 32px); border-radius: var(--r-lg); background: var(--ink-900); color: var(--on-ink); box-shadow: var(--shadow-ink); container-type: inline-size; display: grid; gap: var(--s-2); }
  .res-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
