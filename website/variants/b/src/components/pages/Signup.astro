---
// Sign-up (aanmelden / inscription): continues the home calculator.
// Steps: 1 home (postcode · energy · housing · kWh) → 2 meter & extras → 3 indicative estimate (range, net of fee,
// recommended plan, method popover, fn-6) → 4 plan (Switch Plus preselected; Premium for digital + solar) · preference ·
// email + separate unticked marketing consent → confirmation (no backend).
// Progressive enhancement: without JS every step is a visible fieldset in one GET form. With JS: one step at a time,
// prefill from ?postcode&woning&energie&kwh_elek&kwh_gas&plan, history per step, focus to step heading, error summary
// + inline errors (aria-invalid/aria-describedby, aria-live), `signup_started` on the first valid postcode.
import { Image } from 'astro:assets';
import { href } from '@shared/routes.mjs';
import Base from '../../layouts/Base.astro';
import Icons from '../Icons.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Stars from '../Stars.astro';
import Fn from '../Fn.astro';
import AnimIcon from '../AnimIcon.astro';
import cheering from '@shared/assets/character/june-character-cheering.png';
import { signupCopy } from '../../content/signup';
import { copy } from '../../content/home';
import { estimate, eur, eurDec, eurRange, HOUSINGS, type Locale } from '../../lib/estimate';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const base = import.meta.env.BASE_URL;
const fr = locale === 'fr-be';
const t = signupCopy(locale);
const hc = copy(locale);
const self = href('signup', locale, base);
const e = estimate({ housing: 'terraced', energy: 'both' });
const icons = { apartment: 'h-apartment', terraced: 'h-terraced', semi: 'h-semi', detached: 'h-detached' } as const;
const cfg = { locale, t: { s1: t.s1, s2: { choose: t.s2.choose }, s3: { per: '', rec: t.s3.rec, recWhy: t.s3.recWhy }, s4: { emailEmpty: t.s4.emailEmpty, emailInvalid: t.s4.emailInvalid, termsErr: t.s4.termsErr },
  steps: t.steps, prefOpts: t.s4.prefOpts, plans: t.plans.map(p => ({ slug: p.slug, name: p.name })), errTitle: t.errTitle, energyOpts: t.s1.energyOpts, housingOpts: t.s1.housingOpts,
  fr, perTpl: fr ? 'par an, après l’abonnement {p}' : 'per jaar, na je abonnement {p}', feeTpl: fr ? 'Abonnement {p}' : 'Abonnement {p}', ctaTpl: fr ? 'Continuer avec {p}' : 'Verder met {p}',
  progress: fr ? 'Étape {n} sur 4' : 'Stap {n} van 4', docTitle: fr ? 'Étape {n} sur 4 · {l} – Inscription | June' : 'Stap {n} van 4 · {l} – Aanmelden | June',
  doneBody: fr ? 'Nous avons envoyé un e-mail à {e}. Cliquez sur le lien pour finaliser votre inscription.' : 'We stuurden een e-mail naar {e}. Klik op de link om je aanmelding af te ronden.',
  doneTitle: fr ? 'Inscription commencée – June' : 'Aanmelding gestart – June' } };
---
<Base locale={locale} routeKey="signup" title={t.meta.title} description={t.meta.description} crumbs={[[fr ? 'Inscription' : 'Aanmelden', 'signup']]}>
  <Icons />
  <Header locale={locale} routeKey="signup" funnel />
  <main id="main" tabindex="-1" class="su">
    <div class="wrap">
      <div class="su-head">
        <h1 id="su-h1">{t.h1}</h1>
        <p class="su-sub">{t.sub}</p>
        <div class="prog" data-prog>
          <p class="prog-t"><span data-prog-text>{t.progress(1)} · {t.steps[0]}</span> <span class="muted">({t.time})</span></p>
          <ol role="list" class="prog-bar">
            {t.steps.map((s, i) => <li data-prog-step={i + 1} aria-current={i === 0 ? 'step' : undefined}><span class="prog-n" aria-hidden="true">{i + 1}</span><span class="prog-l">{s}</span></li>)}
          </ol>
        </div>
        <p class="plan-chip" data-plan-chip hidden><svg class="i" aria-hidden="true"><use href="#i-shield" /></svg><span>{t.chosen} <strong data-plan-chip-name></strong></span> <button type="button" class="linkbtn" data-goto="4">{t.change}</button></p>
      </div>

      <div class="su-grid">
        <form class="su-form" id="su" action={self} method="get" data-su>
          <div class="errsum" data-errsum tabindex="-1" hidden role="alert" aria-labelledby="errsum-t">
            <p id="errsum-t" class="errsum-t">{t.errTitle}</p>
            <ul data-errlist></ul>
          </div>

          <!-- STEP 1 -->
          <fieldset class="step" data-step="1" aria-labelledby="s1-h">
            <legend class="sr-only">{t.steps[0]}</legend>
            <h2 id="s1-h" class="step-h" tabindex="-1">{t.s1.h}</h2>
            <div class="f">
              <label class="lbl" for="su-pc">{t.s1.pc} <span class="req">({t.s4.required})</span></label>
              <div class="pc">
                <svg class="i pc-i" aria-hidden="true"><use href="#i-pin" /></svg>
                <input id="su-pc" name="postcode" type="text" inputmode="numeric" autocomplete="postal-code" pattern="[1-9][0-9]{3}" maxlength="4" placeholder={fr ? "1000" : "2000"} required aria-describedby="su-pc-help su-pc-err" />
                <span class="pc-ok" data-pc-ok aria-live="polite"></span>
              </div>
              <p class="help" id="su-pc-help">{t.s1.pcHelp}</p>
              <p class="err" id="su-pc-err" data-err-for="postcode" aria-live="polite"></p>
            </div>
            <fieldset class="f" aria-describedby="su-energy-err">
              <legend class="lbl">{t.s1.energy}</legend>
              <div class="chips chips--2">
                <label class="ch"><input type="radio" name="energie" value="elec" /><span><span class="dot dot--elec" aria-hidden="true"><svg class="i"><use href="#i-zap" /></svg></span>{t.s1.energyOpts.elec}</span></label>
                <label class="ch"><input type="radio" name="energie" value="both" checked /><span><span class="dot dot--elec" aria-hidden="true"><svg class="i"><use href="#i-zap" /></svg></span><span class="dot dot--gas" aria-hidden="true"><svg class="i"><use href="#i-flame" /></svg></span>{t.s1.energyOpts.both}</span></label>
              </div>
              <p class="err" id="su-energy-err" data-err-for="energie" aria-live="polite"></p>
            </fieldset>
            <fieldset class="f" aria-describedby="su-housing-help su-housing-err">
              <legend class="lbl">{t.s1.housing}</legend>
              <p class="help" id="su-housing-help">{t.s1.housingHelp}</p>
              <div class="chips chips--4">
                {HOUSINGS.map(h => <label class="ch ch--tile"><input type="radio" name="woning" value={h} checked={h === 'terraced'} /><span><svg class="i" aria-hidden="true"><use href={`#${icons[h]}`} /></svg>{t.s1.housingOpts[h]}</span></label>)}
              </div>
              <p class="err" id="su-housing-err" data-err-for="woning" aria-live="polite"></p>
            </fieldset>
            <details class="know" data-know>
              <summary><svg class="i chev" aria-hidden="true"><use href="#i-chevron" /></svg>{t.s1.know}</summary>
              <p class="help" id="su-know-help">{t.s1.knowHelp}</p>
              <div class="know-grid">
                <div class="f">
                  <label class="lbl lbl--s" for="su-elec">{t.s1.elec} <span class="unit">({t.s1.unit})</span></label>
                  <input class="inp" id="su-elec" name="kwh_elek" type="number" inputmode="numeric" min="300" max="15000" step="1" aria-describedby="su-know-help su-elec-err" />
                  <p class="err" id="su-elec-err" data-err-for="kwh_elek" aria-live="polite"></p>
                </div>
                <div class="f" data-gas-field>
                  <label class="lbl lbl--s" for="su-gas">{t.s1.gas} <span class="unit">({t.s1.unit})</span></label>
                  <input class="inp" id="su-gas" name="kwh_gas" type="number" inputmode="numeric" min="1000" max="60000" step="1" aria-describedby="su-know-help su-gas-err" />
                  <p class="err" id="su-gas-err" data-err-for="kwh_gas" aria-live="polite"></p>
                </div>
              </div>
            </details>
            <div class="nav"><button class="btn btn--lg" type="button" data-next="1">{t.next}<svg class="i" aria-hidden="true"><use href="#i-arrow" /></svg></button></div>
          </fieldset>

          <!-- STEP 2 -->
          <fieldset class="step" data-step="2" aria-labelledby="s2-h">
            <legend class="sr-only">{t.steps[1]}</legend>
            <p class="recap" data-recap hidden><span class="recap-l">{t.prefilled}</span> <span data-recap-text></span> <button type="button" class="linkbtn" data-goto="1">{t.edit}</button></p>
            <h2 id="s2-h" class="step-h" tabindex="-1">{t.s2.h}</h2>
            <fieldset class="f" aria-describedby="su-meter-help su-meter-err">
              <legend class="lbl">{t.s2.meter} <span class="req">({t.s4.required})</span></legend>
              <p class="help" id="su-meter-help">{t.s2.meterHelp}</p>
              <div class="chips chips--3">
                {(['digital', 'analogue', 'unknown'] as const).map(m => <label class="ch"><input type="radio" name="meter" value={m} required /><span><svg class="i" aria-hidden="true"><use href={m === 'digital' ? '#i-meter' : m === 'analogue' ? '#i-gauge' : '#i-help'} /></svg>{t.s2.meterOpts[m]}</span></label>)}
              </div>
              <p class="err" id="su-meter-err" data-err-for="meter" aria-live="polite"></p>
            </fieldset>
            <fieldset class="f" aria-describedby="su-solar-err">
              <legend class="lbl">{t.s2.solar} <span class="req">({t.s4.required})</span></legend>
              <div class="chips chips--2 chips--narrow">
                <label class="ch"><input type="radio" name="zon" value="ja" required /><span><svg class="i" aria-hidden="true"><use href="#i-sun" /></svg>{t.s2.yes}</span></label>
                <label class="ch"><input type="radio" name="zon" value="nee" required /><span>{t.s2.no}</span></label>
              </div>
              <p class="err" id="su-solar-err" data-err-for="zon" aria-live="polite"></p>
            </fieldset>
            <fieldset class="f" aria-describedby="su-extras-help">
              <legend class="lbl">{t.s2.extras}</legend>
              <div class="chips chips--2 chips--narrow">
                <label class="ch ch--check"><input type="checkbox" name="extra" value="ev" /><span><svg class="i" aria-hidden="true"><use href="#i-car" /></svg>{t.s2.extrasOpts.ev}</span></label>
                <label class="ch ch--check"><input type="checkbox" name="extra" value="warmtepomp" /><span><svg class="i" aria-hidden="true"><use href="#i-heat" /></svg>{t.s2.extrasOpts.heatpump}</span></label>
              </div>
              <p class="help" id="su-extras-help">{t.s2.extrasHelp}</p>
            </fieldset>
            <details class="know edge">
              <summary><svg class="i chev" aria-hidden="true"><use href="#i-chevron" /></svg>{t.s2.budget}</summary>
              <p class="help">{t.s2.budgetB} <span class="chip chip--placeholder">{t.s2.budgetFlag}</span></p>
            </details>
            <div class="nav">
              <button class="btn btn--ghost" type="button" data-back><svg class="i" aria-hidden="true"><use href="#i-arrow-left" /></svg>{t.back}</button>
              <button class="btn btn--lg" type="button" data-next="2">{t.toEstimate}<svg class="i" aria-hidden="true"><use href="#i-arrow" /></svg></button>
            </div>
          </fieldset>

          <!-- STEP 3 -->
          <section class="step" data-step="3" aria-labelledby="s3-h">
            <h2 id="s3-h" class="step-h" tabindex="-1">{t.s3.h}</h2>
            <div class="res on-ink" data-res>
              <div class="res-head"><p class="res-label">{t.s3.label}</p><span class="res-chip">{t.s3.chip}<Fn n={6} fr={fr} /></span></div>
              <div class="res-fig" data-fig>
                <button class="est" type="button" popovertarget="su-method" aria-label={t.s3.method}>≈</button>
                <p class="res-num num" data-num>{eurRange(e.net[0], e.net[1], locale)}</p>
              </div>
              <p class="res-per" data-per>{t.s3.per('Switch Plus')}</p>
              <div class="res-low" data-low hidden>
                <AnimIcon name="relax" size={72} />
                <div><p class="res-low-t">{t.s3.lowT}</p><p class="res-low-b">{t.s3.lowB}</p></div>
              </div>
              <dl class="ledger">
                <div><dt><span class="lg lg--elec" aria-hidden="true"></span>{t.s3.elec}</dt><dd class="num" data-elec>{eurRange(e.elec[0], e.elec[1], locale)}</dd></div>
                <div data-gas-row><dt><span class="lg lg--gas" aria-hidden="true"></span>{t.s3.gas}</dt><dd class="num" data-gas>{eurRange(e.gas[0], e.gas[1], locale)}</dd></div>
                <div><dt><span class="lg lg--fee" aria-hidden="true"></span><span data-fee-label>{t.s3.fee('Switch Plus')}</span></dt><dd class="num" data-fee>− {eur(99, locale)}</dd></div>
              </dl>
              <div class="rec">
                <p class="rec-l">{t.s3.rec}</p>
                <p class="rec-n" data-rec-name>Switch Plus</p>
                <p class="rec-w" data-rec-why>{t.s3.recWhy['switch-plus']}</p>
              </div>
              <p class="res-after">{t.s3.after}<Fn n={6} fr={fr} /></p>
              <noscript><p class="res-after">{t.s3.noscript}</p><style>.res-fig,.res-per,.ledger,.rec{display:none!important}</style></noscript>
              <p class="sr-only" aria-live="polite" data-live></p>
            </div>
            <div class="nav">
              <button class="btn btn--ghost" type="button" data-back><svg class="i" aria-hidden="true"><use href="#i-arrow-left" /></svg>{t.back}</button>
              <button class="btn btn--lg" type="button" data-next="3" data-cta3>{t.s3.cta('Switch Plus')}<svg class="i" aria-hidden="true"><use href="#i-arrow" /></svg></button>
            </div>
            <div id="su-method" class="pop" popover>
              <p class="pop-t">{t.s3.methodTitle}</p>
              <ol class="pop-list">{t.s3.methodItems.map(m => <li>{m}</li>)}</ol>
              <p class="pop-note"><svg class="i" aria-hidden="true"><use href="#i-info" /></svg>{t.s3.methodNote}</p>
              <button class="btn btn--sm btn--ghost" type="button" popovertarget="su-method" popovertargetaction="hide">{fr ? 'Fermer' : 'Sluiten'}</button>
            </div>
          </section>

          <!-- STEP 4 -->
          <fieldset class="step" data-step="4" aria-labelledby="s4-h">
            <legend class="sr-only">{t.steps[3]}</legend>
            <h2 id="s4-h" class="step-h" tabindex="-1">{t.s4.h}</h2>
            <fieldset class="f">
              <legend class="lbl">{t.s4.plan}</legend>
              <div class="plans">
                {t.plans.map(p => (
                  <label class="pl" data-pl={p.slug}>
                    <input type="radio" name="plan" value={p.slug} checked={p.slug === 'switch-plus'} />
                    <span class="pl-in">
                      <span class="pl-top"><span class="pl-name">{p.name}</span><span class="pl-badge" data-rec-badge hidden>{t.s4.recBadge}</span></span>
                      <span class="pl-price"><span class="num">{eur(p.yearly, locale)}</span> {t.s4.perYear}</span>
                      <span class="pl-sub">{t.s4.monthly(eurDec(p.monthly, locale))}{p.slug === 'premium' ? (fr ? ', dongle inclus' : ', dongle inbegrepen') : ''}</span>
                      <span class="pl-pts">{p.points.map(x => <span><svg class="i" aria-hidden="true"><use href="#i-check" /></svg>{x}</span>)}</span>
                    </span>
                  </label>
                ))}
              </div>
              <p class="warn" data-prem-warn hidden><svg class="i" aria-hidden="true"><use href="#i-info" /></svg>{t.s4.premiumAnalogue}</p>
              <p class="fine">{hc.plans.footnote}</p>
            </fieldset>
            <fieldset class="f">
              <legend class="lbl">{t.s4.pref}</legend>
              <div class="chips chips--2">
                {(['auto', 'ask'] as const).map(k => <label class="ch ch--2l"><input type="radio" name="voorkeur" value={k} checked={k === 'auto'} /><span><strong>{t.s4.prefOpts[k][0]}</strong><small>{t.s4.prefOpts[k][1]}</small></span></label>)}
              </div>
            </fieldset>
            <div class="f cb">
              <input type="checkbox" id="su-green" name="groen" value="ja" aria-describedby="su-green-help" />
              <label for="su-green"><svg class="i" aria-hidden="true"><use href="#i-leaf" /></svg>{t.s4.green}</label>
              <p class="help" id="su-green-help">{t.s4.greenHelp}</p>
            </div>
            <div class="two">
              <div class="f">
                <label class="lbl lbl--s" for="su-name">{t.s4.name}</label>
                <input class="inp" id="su-name" name="voornaam" type="text" autocomplete="given-name" />
              </div>
              <div class="f">
                <label class="lbl lbl--s" for="su-email">{t.s4.email} <span class="req">({t.s4.required})</span></label>
                <input class="inp" id="su-email" name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby="su-email-help su-email-err" />
                <p class="help" id="su-email-help">{t.s4.emailHelp}</p>
                <p class="err" id="su-email-err" data-err-for="email" aria-live="polite"></p>
              </div>
            </div>
            <div class="f cb">
              <input type="checkbox" id="su-terms" name="voorwaarden" value="ja" required aria-describedby="su-terms-err" />
              <label for="su-terms">{t.s4.terms} <span class="req">({t.s4.required})</span> <span class="chip chip--placeholder">{t.s4.termsFlag}</span></label>
              <p class="err" id="su-terms-err" data-err-for="voorwaarden" aria-live="polite"></p>
            </div>
            <div class="f cb">
              <input type="checkbox" id="su-mkt" name="nieuws" value="ja" aria-describedby="su-mkt-help" />
              <label for="su-mkt">{t.s4.marketing}</label>
              <p class="help" id="su-mkt-help">{t.s4.marketingHelp}</p>
            </div>
            <details class="know">
              <summary><svg class="i chev" aria-hidden="true"><use href="#i-chevron" /></svg>{t.s4.referral}</summary>
              <div class="f"><label class="lbl lbl--s" for="su-ref">{t.s4.referralL}</label><input class="inp inp--s" id="su-ref" name="code" type="text" autocomplete="off" /></div>
            </details>
            <div class="nav">
              <button class="btn btn--ghost" type="button" data-back><svg class="i" aria-hidden="true"><use href="#i-arrow-left" /></svg>{t.back}</button>
              <button class="btn btn--lg" type="submit" data-submit>{t.s4.submit}<svg class="i" aria-hidden="true"><use href="#i-arrow" /></svg></button>
            </div>
            <p class="under"><svg class="i" aria-hidden="true"><use href="#i-lock" /></svg>{t.s4.under}</p>
            <p class="small muted">{t.s4.next}</p>
          </fieldset>
        </form>

        <!-- CONFIRMATION (JS only) -->
        <section class="done" data-done hidden aria-labelledby="done-h">
          <Image src={cheering} alt="" width={180} height={Math.round(180 * cheering.height / cheering.width)} loading="lazy" class="done-char" />
          <h2 id="done-h" tabindex="-1">{t.done.h}</h2>
          <p class="done-b" data-done-body>{t.done.bodyNoEmail}</p>
          <dl class="done-sum" aria-label={t.done.summary}>
            <div><dt>{t.done.plan}</dt><dd data-sum-plan></dd></div>
            <div><dt>{t.done.pref}</dt><dd data-sum-pref></dd></div>
            <div><dt>{t.done.where}</dt><dd data-sum-pc></dd></div>
            <div><dt>{t.done.est}<Fn n={6} fr={fr} /></dt><dd data-sum-est></dd></div>
          </dl>
          <h3>{t.done.next}</h3>
          <ol class="done-next">{t.done.nextItems.map(x => <li>{x}</li>)}</ol>
          <p class="small">{t.done.notReceived} <button type="button" class="linkbtn" data-resend>{t.done.resend}</button>. <span data-resent aria-live="polite"></span></p>
          <p><a class="link-arrow" href={href('home', locale, base)}>{t.done.home}<svg class="i" aria-hidden="true"><use href="#i-arrow" /></svg></a></p>
          <p class="fine"><span class="chip chip--placeholder">{t.done.proto}</span></p>
        </section>

        <aside class="su-aside" aria-labelledby="aside-h">
          <h2 id="aside-h" class="aside-h">{t.asideH}</h2>
          <ul role="list" class="aside-l">
            {t.aside.map((x, i) => <li>{i === 1 ? <Stars label={hc.hero.starsLabel} size={14} /> : <svg class="i" aria-hidden="true"><use href={`#i-${['user', 'check', 'plug', 'hand'][i]}`} /></svg>}<span>{x}{i < 2 && <Fn n={i === 0 ? 3 : 2} fr={fr} />}</span></li>)}
            <li><svg class="i" aria-hidden="true"><use href="#i-shield" /></svg><span>{t.guarantee}: {fr ? '99 € remboursés si vous n’économisez pas plus que votre abonnement' : '€ 99 terug als je niet meer bespaart dan je abonnement'}<Fn n={4} fr={fr} /></span></li>
          </ul>
          <div class="aside-need">
            <p class="aside-h2">{t.needH}</p>
            <ul role="list">{t.need.map(x => <li><svg class="i" aria-hidden="true"><use href="#i-doc" /></svg>{x}</li>)}</ul>
            <p class="small muted"><svg class="i" aria-hidden="true"><use href="#i-lock" /></svg>{t.privacy}</p>
          </div>
        </aside>
      </div>
    </div>
  </main>
  <Footer locale={locale} minimal />
</Base>

<script type="application/json" id="su-cfg" set:html={JSON.stringify(cfg)} />
<script>
  import { estimate, eur, eurRange, fromParams, region, recommendPlan, STORE_KEY, type Locale, type PlanSlug, type Meter } from '../../lib/estimate';
  import { track, signupStarted } from '../../lib/track';
  const RAW = JSON.parse(document.getElementById('su-cfg')!.textContent!);
  const C = { ...RAW.t, locale: RAW.locale, t: RAW.t };
  const L: Locale = C.locale; const T = RAW.t;
  const form = document.querySelector<HTMLFormElement>('[data-su]')!;
  const $ = <E extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector(s) as E;
  const $$ = <E extends Element = HTMLElement>(s: string, r: ParentNode = document) => [...r.querySelectorAll(s)] as E[];
  const steps = $$<HTMLElement>('[data-step]');
  const errsum = $('[data-errsum]'), errlist = $('[data-errlist]');
  const pc = $<HTMLInputElement>('#su-pc'), pcOk = $('[data-pc-ok]');
  const fill = (tpl: string, o: Record<string, string | number>) => tpl.replace(/\{(\w)\}/g, (_, k) => String(o[k] ?? ''));
  const planName = (s: string) => C.t.plans.find((p: any) => p.slug === s)?.name ?? s;
  form.noValidate = true;
  document.documentElement.classList.add('su-js');

  let current = 1, maxReached = 1, recommended: PlanSlug = 'switch-plus', planTouched = false;

  /* ── state helpers ── */
  const val = (n: string) => { const el = form.elements.namedItem(n) as any; return el ? (el.value ?? '') : ''; };
  const checked = (n: string) => (form.querySelector(`[name="${n}"]:checked`) as HTMLInputElement | null)?.value ?? '';
  const setRadio = (n: string, v?: string) => { if (!v) return; const el = form.querySelector<HTMLInputElement>(`[name="${n}"][value="${v}"]`); if (el) el.checked = true; };
  const num = (v: string) => (v && /^\d+$/.test(v.trim()) ? Number(v) : null);
  const input = () => ({ housing: checked('woning') as any || 'terraced', energy: (checked('energie') || 'both') as any, elecKwh: num(val('kwh_elek')), gasKwh: num(val('kwh_gas')), solar: checked('zon') === 'ja' });
  const save = () => { try { sessionStorage.setItem(STORE_KEY, JSON.stringify({ ...input(), postcode: pc.value.trim() })); } catch { /* ignore */ } };

  /* ── errors ── */
  function setErr(name: string, msg: string) {
    const p = $(`[data-err-for="${name}"]`); if (p) p.textContent = msg;
    const inputs = $$<HTMLInputElement>(`[name="${name}"]`);
    inputs.forEach(i => (msg ? i.setAttribute('aria-invalid', 'true') : i.removeAttribute('aria-invalid')));
  }
  function showSummary(errs: [string, string, string][]) {
    errlist.innerHTML = '';
    if (!errs.length) { errsum.hidden = true; return; }
    for (const [, msg, id] of errs) { const li = document.createElement('li'); const a = document.createElement('a'); a.href = `#${id}`; a.textContent = msg; a.addEventListener('click', ev => { ev.preventDefault(); document.getElementById(id)?.focus(); }); li.append(a); errlist.append(li); }
    errsum.hidden = false; errsum.focus();
  }
  function validate(step: number): boolean {
    const errs: [string, string, string][] = [];
    const add = (name: string, msg: string, id: string) => { setErr(name, msg); errs.push([name, msg, id]); };
    if (step === 1) {
      const v = pc.value.trim();
      ['postcode', 'energie', 'woning', 'kwh_elek', 'kwh_gas'].forEach(n => setErr(n, ''));
      if (!v) add('postcode', T.s1.pcEmpty, 'su-pc'); else if (!region(v)) add('postcode', T.s1.pcInvalid, 'su-pc');
      if (!checked('energie')) add('energie', T.s1.choose, form.querySelector<HTMLInputElement>('[name="energie"]')!.id || 'su-pc');
      const e = num(val('kwh_elek')), g = num(val('kwh_gas'));
      if (e !== null && (e < 300 || e > 15000)) add('kwh_elek', T.s1.tooMuch, 'su-elec');
      if (g !== null && checked('energie') === 'both' && (g < 1000 || g > 60000)) add('kwh_gas', T.s1.tooMuch, 'su-gas');
      if (errs.some(x => x[0].startsWith('kwh'))) ($('[data-know]') as HTMLDetailsElement).open = true;
    }
    if (step === 2) {
      ['meter', 'zon'].forEach(n => setErr(n, ''));
      if (!checked('meter')) add('meter', T.s2.choose, 'su-meter-first');
      if (!checked('zon')) add('zon', T.s2.choose, 'su-zon-first');
    }
    if (step === 4) {
      ['email', 'voorwaarden'].forEach(n => setErr(n, ''));
      const em = val('email').trim();
      if (!em) add('email', T.s4.emailEmpty, 'su-email'); else if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(em)) add('email', T.s4.emailInvalid, 'su-email');
      if (!($('#su-terms') as HTMLInputElement).checked) add('voorwaarden', T.s4.termsErr, 'su-terms');
    }
    for (const [name] of errs) track('signup_error', { step, field: name, error_type: 'invalid' });
    showSummary(errs);
    return errs.length === 0;
  }
  // ids for first radio of groups (error-summary links)
  (form.querySelector('[name="meter"]') as HTMLElement).id = 'su-meter-first';
  (form.querySelector('[name="zon"]') as HTMLElement).id = 'su-zon-first';
  (form.querySelector('[name="energie"]') as HTMLElement).id = 'su-energie-first';

  /* ── postcode live confirmation ── */
  function pcStatus() { const r = region(pc.value.trim()); pcOk.textContent = r ? `✓ ${T.s1.regions[r]}` : ''; if (r) setErr('postcode', ''); return r; }
  pc.addEventListener('input', () => { pc.value = pc.value.replace(/\D/g, '').slice(0, 4); pcStatus(); });
  pc.addEventListener('blur', () => { const v = pc.value.trim(); if (v && !region(v)) setErr('postcode', T.s1.pcInvalid); });
  const gasField = $('[data-gas-field]');
  const syncGas = () => { const both = checked('energie') === 'both'; gasField.hidden = !both; ($('#su-gas') as HTMLInputElement).disabled = !both; };
  form.addEventListener('change', ev => {
    const n = (ev.target as HTMLInputElement).name;
    if (n === 'energie') syncGas();
    if (['meter', 'zon'].includes(n)) setErr(n, '');
    if (n === 'plan') { planTouched = true; syncPlan(); }
    if (n === 'meter') syncPlan();
  });

  /* ── estimate (step 3) — the ONE model in lib/estimate.ts ── */
  const selectedPlan = () => (checked('plan') || 'switch-plus') as PlanSlug;
  function renderEstimate() {
    const i = input();
    recommended = recommendPlan(checked('meter') as Meter, i.solar);
    if (!planTouched && !initialPlan) setRadio('plan', recommended);
    const plan = selectedPlan();
    const e = estimate({ ...i, plan });
    $('[data-num]').textContent = eurRange(e.net[0], e.net[1], L);
    $('[data-per]').textContent = fill(C.perTpl, { p: planName(plan) });
    $('[data-elec]').textContent = eurRange(e.elec[0], e.elec[1], L);
    $('[data-gas]').textContent = eurRange(e.gas[0], e.gas[1], L);
    $('[data-gas-row]').hidden = i.energy !== 'both';
    $('[data-fee-label]').textContent = fill(C.feeTpl, { p: planName(plan) });
    $('[data-fee]').textContent = `− ${eur(e.fee, L)}`;
    $('[data-rec-name]').textContent = planName(recommended);
    $('[data-rec-why]').textContent = T.s3.recWhy[recommended];
    $('[data-low]').hidden = !e.low; $('[data-per]').hidden = e.low; $('[data-fig]').classList.toggle('is-muted', e.low);
    $('[data-cta3]').firstChild!.textContent = fill(C.ctaTpl, { p: planName(plan) });
    $('[data-live]').textContent = `${$('#s3-h').textContent}: ≈ ${eurRange(e.net[0], e.net[1], L)}`;
    save();
    return e;
  }
  function syncPlan() {
    $$('[data-rec-badge]').forEach(b => (b.hidden = b.closest('[data-pl]')!.getAttribute('data-pl') !== recommended));
    $('[data-prem-warn]').hidden = !(selectedPlan() === 'premium' && checked('meter') === 'analogue');
    const chip = $('[data-plan-chip]');
    if (initialPlan || planTouched) { chip.hidden = false; $('[data-plan-chip-name]').textContent = planName(selectedPlan()); }
  }

  /* ── step machine ── */
  function show(n: number, push = true, focus = true) {
    current = n; maxReached = Math.max(maxReached, n);
    steps.forEach(s => (s.hidden = s.dataset.step !== String(n)));
    $$<HTMLElement>('[data-prog-step]').forEach(li => { const k = Number(li.dataset.progStep); li.toggleAttribute('aria-current', false); if (k === n) li.setAttribute('aria-current', 'step'); li.dataset.state = k < n ? 'done' : k === n ? 'now' : 'todo'; });
    $('[data-prog-text]').textContent = `${fill(C.progress, { n })} · ${T.steps[n - 1]}`;
    document.title = fill(C.docTitle, { n, l: T.steps[n - 1] });
    if (n === 3) renderEstimate();
    if (n === 4) syncPlan();
    errsum.hidden = true;
    if (push) history.pushState({ step: n }, '', `#stap-${n}`);
    if (focus) { const h = $<HTMLElement>(`#s${n}-h`); h.focus({ preventScroll: true }); const top = form.getBoundingClientRect().top + scrollY - 120; if (scrollY > top) scrollTo({ top, behavior: 'auto' }); }
    track('signup_step_viewed', { step: n, step_name: ['home', 'meter', 'estimate', 'account'][n - 1] });
  }
  function recapText() {
    const r = region(pc.value.trim());
    return `${pc.value.trim()}${r ? ' ' + T.s1.regions[r] : ''} · ${C.t.housingOpts[checked('woning')] ?? ''} · ${C.t.energyOpts[checked('energie')] ?? ''}`;
  }
  const t0 = performance.now();
  form.addEventListener('click', ev => {
    const b = (ev.target as HTMLElement).closest('button'); if (!b) return;
    if (b.dataset.next) {
      const n = Number(b.dataset.next);
      if (!validate(n)) return;
      if (n === 1) { signupStarted(pc.value.trim(), { entry_cta_id: 'signup_step1', locale: L, plan: selectedPlan(), route_key: 'signup' }); $('[data-recap-text]').textContent = recapText(); $('[data-recap]').hidden = false; save(); }
      track('signup_step_completed', { step: n, duration_bucket: (performance.now() - t0) < 30000 ? '<30s' : (performance.now() - t0) < 120000 ? '30-120s' : '>120s' });
      show(n + 1);
    }
    if (b.hasAttribute('data-back')) history.back();
  });
  document.addEventListener('click', ev => {
    const g = (ev.target as HTMLElement).closest<HTMLElement>('[data-goto]'); if (!g) return;
    const n = Number(g.dataset.goto); if (n <= maxReached || n === 1) show(n); else { show(Math.min(maxReached, 4)); }
  });
  addEventListener('popstate', ev => { const n = ev.state?.step ?? 1; if (!$('[data-done]').hidden) return; show(Math.min(n, maxReached), false); });

  form.addEventListener('submit', ev => {
    ev.preventDefault();
    if (current !== 4) { const b = $<HTMLButtonElement>(`[data-next="${current}"]`); b?.click(); return; }
    if (!validate(4)) return;
    track('signup_submitted', { plan: selectedPlan(), preference: checked('voorkeur'), marketing_opt_in: ($('#su-mkt') as HTMLInputElement).checked });
    const e = estimate({ ...input(), plan: selectedPlan() });
    const done = $('[data-done]');
    const email = val('email').trim();
    const body = $('[data-done-body]'); body.textContent = '';
    const parts = C.doneBody.split('{e}'); body.append(parts[0]); const s = document.createElement('strong'); s.textContent = email; body.append(s, parts[1]);
    $('[data-sum-plan]').textContent = planName(selectedPlan());
    $('[data-sum-pref]').textContent = C.t.prefOpts[checked('voorkeur') || 'auto'][0];
    $('[data-sum-pc]').textContent = pc.value.trim();
    $('[data-sum-est]').textContent = e.low ? '—' : `≈ ${eurRange(e.net[0], e.net[1], L)}`;
    form.hidden = true; $('[data-prog]').hidden = true; $('[data-plan-chip]').hidden = true; done.hidden = false;
    $$<HTMLElement>('[data-prog-step]').forEach(li => (li.dataset.state = 'done'));
    document.title = C.doneTitle;
    history.replaceState({ step: 5 }, '', '#klaar');
    $<HTMLElement>('#done-h').focus();
    scrollTo({ top: 0 });
  });
  $('[data-resend]').addEventListener('click', () => { $('[data-resent]').textContent = C.fr ? 'C’est renvoyé. Vérifiez aussi vos spams.' : 'Opnieuw verstuurd. Kijk ook in je spam.'; });

  /* ── language switch keeps the non-PII query ── */
  const lang = document.querySelector<HTMLAnchorElement>('[data-lang-keep-query]');
  const keepQuery = () => {
    if (!lang) return;
    const q = new URLSearchParams();
    if (region(pc.value.trim())) q.set('postcode', pc.value.trim());
    q.set('woning', checked('woning')); q.set('energie', checked('energie'));
    for (const k of ['kwh_elek', 'kwh_gas']) { const v = num(val(k)); if (v) q.set(k, String(v)); }
    q.set('plan', selectedPlan());
    lang.href = lang.href.split('?')[0] + '?' + q.toString();
  };
  form.addEventListener('change', keepQuery); pc.addEventListener('input', keepQuery);

  /* ── prefill from the home calculator / plan cards ── */
  const P = fromParams(new URLSearchParams(location.search));
  const fromCalc = !!(P.postcode && region(P.postcode) && P.housing && P.energy);
  // The calculator's CTA carries the default plan (switch-plus); treat that as a soft default the recommendation may
  // override. A plan chosen on a plan card (?plan=… without calculator data) is an explicit choice and is respected.
  const initialPlan = fromCalc && P.plan === 'switch-plus' ? undefined : P.plan;
  if (P.postcode) { pc.value = P.postcode; pcStatus(); }
  setRadio('energie', P.energy); setRadio('woning', P.housing);
  if (P.elecKwh) { ($('#su-elec') as HTMLInputElement).value = String(P.elecKwh); ($('[data-know]') as HTMLDetailsElement).open = true; }
  if (P.gasKwh) { ($('#su-gas') as HTMLInputElement).value = String(P.gasKwh); ($('[data-know]') as HTMLDetailsElement).open = true; }
  if (initialPlan) { setRadio('plan', initialPlan); }
  syncGas(); syncPlan(); keepQuery();
  if (fromCalc) {
    signupStarted(P.postcode!, { entry_cta_id: 'home_calc_prefill', locale: L, plan: selectedPlan(), route_key: 'signup' });
    $('[data-recap-text]').textContent = recapText(); $('[data-recap]').hidden = false; save();
    maxReached = 2;
    history.replaceState({ step: 1 }, '', location.pathname + location.search);
    show(2, true, false);
  } else {
    history.replaceState({ step: 1 }, '', location.pathname + location.search);
    show(1, false, false);
  }
</script>

<style>
