  .pc-ok { font-size: var(--fs-14); font-weight: 600; color: var(--accent-strong); }
  .inp { width: 100%; height: 52px; padding: 0 14px; border-radius: var(--r-md); border: 1.5px solid var(--hairline-strong); background: var(--surface); font-size: var(--fs-16); }
  .inp--s { max-width: 240px; }
  .pc input:focus, .inp:focus { outline: none; border-color: var(--accent-strong); box-shadow: 0 0 0 3px var(--accent-soft); }
