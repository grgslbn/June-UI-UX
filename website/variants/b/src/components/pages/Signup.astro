  .know > .help, .know > .f { margin-top: var(--s-2); }
  .know-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4); margin-top: var(--s-3); }
  .know-grid [hidden] { display: none; }
  .edge .help { display: block; }
  .edge .chip { margin-top: 6px; }

  .nav { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-3); padding-top: var(--s-2); }
