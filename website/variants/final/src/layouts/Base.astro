---
// Base layout: lang, title, description, canonical, hreflang, robots. Variants extend or replace the body.
// Variant C additions: optional `noindex` (style tile) and pages outside the shared route map (no canonical/hreflang).
import { LOCALES, ROUTES, abs, alternates, NOINDEX } from '@shared/routes.mjs';
interface Props { locale: 'nl-be' | 'fr-be'; routeKey: string; title: string; description: string; noindex?: boolean; }
const { locale, routeKey, title, description, noindex = false } = Astro.props;
const mapped = routeKey in ROUTES;
---
<!doctype html>
<html lang={LOCALES[locale].html}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {mapped && <link rel="canonical" href={abs(routeKey, locale)} />}
    {mapped && alternates(routeKey).map(a => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {(noindex || NOINDEX.has(routeKey)) && <meta name="robots" content="noindex, follow" />}
    <slot name="head" />
  </head>
  <body><slot /></body>
</html>
