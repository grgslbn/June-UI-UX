---
// Home product band (borrowed from A): the real current app (NL/FR mockup) + the leaf dongle, with what each plan shows.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { href } from '@shared/routes.mjs';
import phoneNl from '@shared/assets/app/app-phone-nl.png';
import phoneFr from '@shared/assets/app/app-phone-fr.png';
import dongle from '@shared/assets/dongle/dongle-leaf-closeup.png';
interface Props { c: any; locale: 'nl-be' | 'fr-be'; }
const { c, locale } = Astro.props;
const p = c.product;
---
<section class="section section--deep product-band" id="app" aria-labelledby="product-h">
  <div class="wrap pb-grid">
    <div>
      <SectionHead kicker={p.kicker} id="product-h" title={p.h2}><p>{p.body}</p></SectionHead>
      <ul class="pb-points">{p.points.map((x: string) => <li><Icon name="check" /><span>{x}</span></li>)}</ul>
      <a class="link-arrow" href={href('plans', locale, import.meta.env.BASE_URL) + '#dongle'}>{p.link}<Icon name="arrow-r" /></a>
    </div>
    <figure class="pb-fig">
      <div class="pb-stage">
        <Image src={c.L === 'fr' ? phoneFr : phoneNl} alt={p.alt.phone} widths={[220, 299, 440]} sizes="(max-width: 760px) 46vw, 240px" class="pb-phone" loading="lazy" />
        <Image src={dongle} alt={p.alt.dongle} widths={[200, 400]} sizes="(max-width: 760px) 40vw, 210px" class="pb-dongle" loading="lazy" />
      </div>
      <figcaption class="note">{p.cap}</figcaption>
    </figure>
  </div>
</section>
