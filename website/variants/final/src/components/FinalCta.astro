---
// Closing block on every content page, on a June Green field (brand spark from E): 4-point summary + repeated
// postcode form + proof. Optional June character (≤ 1 per page, never next to prices).
import { Image } from 'astro:assets';
import PostcodeForm from './PostcodeForm.astro';
import Trust from './Trust.astro';
import Icon from './Icon.astro';
import Fn from './Fn.astro';
import pointing from '@shared/assets/character/june-character-pointing.png';
import cheering from '@shared/assets/character/june-character-cheering.png';
interface Props { c: any; locale: 'nl-be' | 'fr-be'; title?: string; character?: 'pointing' | 'cheering' | null; plan?: string; entry?: string; }
const { c, locale, title, character = null, plan, entry = 'final' } = Astro.props;
const img = character === 'cheering' ? cheering : pointing;
---
<section class="section section--close" id="start" aria-labelledby="sum-h">
  <div class="wrap">
    <div class:list={['summary summary--field', { 'summary--char': character }]} data-sticky-hide>
      <div>
        <h2 id="sum-h">{title || c.finalCta.h2}</h2>
        <ul class="sum-points">
          {c.finalCta.points.map((p: string, i: number) => <li><Icon name="check-circle" /><span>{p}{i === 3 && <Fn n={4} L={c.L} />}</span></li>)}
        </ul>
      </div>
      <div class="pc-wrap">
        <PostcodeForm locale={locale} c={c} id="sum" plan={plan} entry={entry} />
        <Trust c={c} id="sum" />
      </div>
      {character && <Image src={img} alt="" class="summary-char" widths={[160, 320]} sizes="160px" width={160} loading="lazy" />}
    </div>
  </div>
</section>
