---
// "Wat jij overhoudt" ledger (borrowed from variant B), shown ONLY when the visitor already has an estimate from the
// sign-up funnel in this session. Before that there are no preset numbers at all: the plans page shows the method
// (besparing − abonnement = wat jij overhoudt) and a CTA to get an estimate.
//
// Contract with the funnel (src/lib + Signup, owned by the funnel builder): after the estimate step, the funnel writes
//   sessionStorage['june-estimate'] = JSON { gross: [lo, hi], net?: { switch: [lo, hi], 'switch-plus': [lo, hi], premium: [lo, hi] } }
// computed by estimate()/net() in src/lib/estimate.js. This component only DISPLAYS those numbers. If `net` is missing it
// subtracts the plan fee with the same rounding as net() (down to 10 / nearest 10, floored at 0), as a fallback only.
//
// Three modes, used in this order on the page (keeps CLS at 0: visibility is decided by a tiny inline script BEFORE the
// ledgers are parsed, and the values are filled by a second one right after the cards, into boxes of fixed height):
//   <PlanLedger mode="boot" c={c} signup={url} />   method box / "your estimate" box + sets html[data-est]
//   <PlanLedger mode="card" c={c} slug="switch" fee={69} />   one per plan card
//   <PlanLedger mode="fill" c={c} />                 fills every ledger
import Icon from './Icon.astro';
import Stars from './Stars.astro';
import Fn from './Fn.astro';
interface Props { c: any; mode: 'boot' | 'card' | 'fill'; slug?: string; fee?: number; name?: string; signup?: string; }
const { c, mode, slug, fee, name, signup } = Astro.props;
const l = c.ledger;
const m = c.method;
const L = c.L;
---
{mode === 'boot' && (
  <>
    <script is:inline>
      (function () {
        try {
          var e = JSON.parse(sessionStorage.getItem('june-estimate') || 'null');
          var g = e && e.gross;
          if (g && g.length === 2 && isFinite(g[0]) && isFinite(g[1]) && g[0] >= 0 && g[1] >= g[0] && g[1] < 10000) {
            window.__juneEst = e; document.documentElement.setAttribute('data-est', '');
          }
        } catch (_) { /* no storage: method only */ }
      })();
    </script>
    <div class="pl-box">
      <div class="pl-method">
        <p class="pl-h">{m.h}</p>
        <p class="pl-eq">
          <span class="sr-only">{`${m.eq[0]} − ${m.eq[1]} = ${m.eq[2]}`}</span>
          <span aria-hidden="true">{m.eq[0]}</span><b aria-hidden="true">−</b><span aria-hidden="true">{m.eq[1]}</span><b aria-hidden="true">=</b><span class="pl-eq-you" aria-hidden="true">{m.eq[2]}</span>
        </p>
        <p class="pl-p">{m.p}</p>
        <a class="btn" href={signup} data-cta="plans-method">{m.cta}<Icon name="arrow-r" /></a>
        <p class="proof"><Stars value={c.rating} id="pl-method" /><span><strong>{c.proof.rating}</strong><Fn n={2} L={L} /></span><span class="sep" aria-hidden="true">·</span><span>{c.proof.riskAlt}</span></p>
      </div>
      <div class="pl-mine">
        <p class="pl-h">{l.title}</p>
        <p class="pl-p">{L === 'fr' ? 'Votre économie estimée' : 'Je geschatte besparing'}: <strong class="num" data-est-gross>≈ …</strong> {l.per}</p>
        <p class="pl-p">{L === 'fr' ? 'Pour chaque abonnement, vous voyez ci-dessous ce qui vous reste, abonnement déduit.' : 'Per abonnement zie je hieronder wat je overhoudt, na aftrek van je abonnement.'}</p>
        <p class="pl-cap">{l.cap}</p>
        <a class="link-arrow" href={signup}>{l.edit}<Icon name="arrow-r" /></a>
      </div>
    </div>
  </>
)}
{mode === 'card' && (
  <div class="pl-card" data-ledger data-plan={slug} data-fee={fee}>
    <p class="pl-title">{l.title}</p>
    <dl>
      <div><dt>{l.save}</dt><dd class="num" data-l-gross>≈ …</dd></div>
      <div><dt>− {l.fee} {name}</dt><dd class="num">− {c.plans.find((p: any) => p.slug === slug)?.yearly}</dd></div>
      <div class="pl-you"><dt>= {l.you}</dt><dd class="num" data-l-net>≈ …</dd></div>
    </dl>
    <p class="pl-low" data-l-low hidden>{l.low}</p>
    {slug !== 'switch' && <p class="pl-low" data-l-guard hidden>{l.guard}</p>}
  </div>
)}
{mode === 'fill' && (
  <script is:inline define:vars={{ L }}>
    (function () {
      var e = window.__juneEst; if (!e) return;
      var fmt = function (n) { var s = String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, L === 'nl' ? '.' : ' '); return L === 'nl' ? '€ ' + s : s + ' €'; };
      var rng = function (r) { return '≈ ' + (r[0] === r[1] ? fmt(r[0]) : fmt(r[0]) + ' – ' + fmt(r[1])); };
      // Fallback only; mirrors net() in src/lib/estimate.js.
      var net = function (g, fee) { return [Math.max(0, Math.floor((g[0] - fee) / 10) * 10), Math.max(0, Math.round((g[1] - fee) / 10) * 10)]; };
      var gEl = document.querySelector('[data-est-gross]'); if (gEl) gEl.textContent = rng(e.gross);
      document.querySelectorAll('[data-ledger]').forEach(function (box) {
        var slug = box.getAttribute('data-plan'), fee = Number(box.getAttribute('data-fee'));
        var n = (e.net && e.net[slug] && e.net[slug].length === 2) ? e.net[slug] : net(e.gross, fee);
        box.querySelector('[data-l-gross]').textContent = rng(e.gross);
        box.querySelector('[data-l-net]').textContent = rng(n);
        if (n[1] <= 0) box.querySelector('[data-l-low]').hidden = false;
        var guard = box.querySelector('[data-l-guard]'); if (guard && n[0] <= 0) guard.hidden = false;
      });
    })();
  </script>
)}
