---
// Partial stars (4,3 → 86% filled). Never five full stars (claims register C3).
interface Props { value: number; id: string; }
const { value, id } = Astro.props;
const pct = Math.max(0, Math.min(1, value / 5));
const star = (x: number) => `M${x + 7} 0.8l1.9 3.9 4.3.6-3.1 3 .7 4.3-3.8-2-3.8 2 .7-4.3-3.1-3 4.3-.6z`;
const d = [0, 15.5, 31, 46.5, 62].map(star).join(' ');
---
<span class="stars" aria-hidden="true">
  <svg viewBox="0 0 76 14">
    <defs><clipPath id={`clip-${id}`}><rect x="0" y="0" width={(76 * pct).toFixed(1)} height="14" /></clipPath></defs>
    <path d={d} fill="none" stroke="var(--ink-400)" stroke-width="1" />
    <path d={d} fill="var(--accent-strong)" clip-path={`url(#clip-${id})`} />
  </svg>
</span>
