---
// Rating band: 4,3 with partial stars, count, source + date (footnote 2). No invented reviews, no silhouettes
// (verbatim Google reviews with first name, town and date come later). No AggregateRating markup.
import Stars from './Stars.astro';
import Fn from './Fn.astro';
import SectionHead from './SectionHead.astro';
interface Props { c: any; n?: string; id?: string; }
const { c, n, id = 'reviews' } = Astro.props;
const fr = c.L === 'fr';
const r = fr
  ? { kicker: 'Ce que disent nos clients', h2: 'Une note de 4,3, pas de 5. Nous la montrons telle quelle.', basis: 'sur Google, sur la base de plus de 1 200 avis', aria: '4,3 sur 5 étoiles', facts: [['20 000+', 'clients', 3], ['17+', 'fournisseurs comparés', 0], ['326 €', 'd’économie moyenne par an', 1]] }
  : { kicker: 'Wat klanten zeggen', h2: 'Een 4,3, geen 5. We tonen hem zoals hij is.', basis: 'op Google, op basis van 1.200+ reviews', aria: '4,3 van 5 sterren', facts: [['20.000+', 'klanten', 3], ['17+', 'leveranciers vergeleken', 0], ['€ 326', 'gemiddelde besparing per jaar', 1]] };
---
<section class="section" id={id} aria-labelledby={`${id}-h`}>
  <div class="wrap">
    <SectionHead n={n} kicker={r.kicker} id={`${id}-h`} title={r.h2} />
    <div class="rating-band">
      <div class="rating">
        <p class="rating-big num" role="img" aria-label={r.aria}>4,3<small aria-hidden="true">/5</small></p>
        <Stars value={c.rating} id={id} />
        <p class="note">{r.basis}<Fn n={2} L={c.L} /></p>
      </div>
      <ul class="rating-facts">
        {r.facts.map(([big, label, fn]) => <li><strong class="num">{big}</strong><span>{label}{fn ? <Fn n={fn as number} L={c.L} /> : null}</span></li>)}
      </ul>
    </div>
  </div>
</section>
