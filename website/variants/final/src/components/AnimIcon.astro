---
// Animated brand icon (blob + line icon + teal accent, 4-s loop). The real <img> is the optimised STATIC frame
// (astro:assets → WebP at 2× the display size, a few KB, reduced-motion safe, no layout shift: fixed width/height).
// The animated WebP (~120–200 KB) is swapped in only when motion is welcome AND the icon scrolls into view.
// Decorative: the adjacent text carries the meaning. API unchanged: { name, size?, eager?, class? }.
import { getImage } from 'astro:assets';
type Name = 'compare' | 'calculator' | 'home-analysis' | 'home-automatic' | 'home-switch' | 'celebrate' | 'relax';
const statics = import.meta.glob<{ default: ImageMetadata }>('../../../../shared/assets/icons/*-static.png', { eager: true });
const anims = import.meta.glob<string>('../../../../shared/assets/icons/*.webp', { eager: true, query: '?url', import: 'default' });
interface Props { name: Name; size?: number; eager?: boolean; class?: string; }
const { name, size = 88, eager = false, class: cls } = Astro.props;
const pick = <T,>(m: Record<string, T>, end: string) => m[Object.keys(m).find((k) => k.endsWith(end))!];
const still = await getImage({ src: pick(statics, `/icon-${name}-static.png`).default, width: Math.min(240, size * 2), format: 'webp', quality: 80 });
const anim = pick(anims, `/icon-${name}.webp`);
---
<span class:list={['anim-icon', cls]} aria-hidden="true"><img src={still.src} data-anim={anim} width={size} height={size} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" /></span>
<script>
  // One observer for every icon on the page (Astro bundles this script once).
  if (matchMedia('(prefers-reduced-motion: no-preference)').matches && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      const img = e.target as HTMLImageElement;
      const a = img.dataset.anim;
      if (a) { const pre = new Image(); pre.onload = () => { img.src = a; }; pre.src = a; }
      io.unobserve(img);
    }), { rootMargin: '120px' });
    document.querySelectorAll<HTMLImageElement>('img[data-anim]').forEach((i) => io.observe(i));
  }
</script>
