---
// Native <details> accordion (deep-linkable ids). Items: { id, q, a (may contain HTML), fn? }.
// No "to be confirmed" tags: unconfirmed answers use the interim wording from the claims register or are left out.
import Icon from './Icon.astro';
import Fn from './Fn.astro';
interface Props { items: any[]; L: string; group?: string; openFirst?: boolean; }
const { items, L, group = 'faq', openFirst = false } = Astro.props;
---
<div class="faq">
  {items.map((f, i) => (
    <details id={f.id} name={group} open={openFirst && i === 0} data-faq>
      <summary><span>{f.q}</span><Icon name="plus" /></summary>
      <div class="faq-a">
        <p><Fragment set:html={f.a} />{f.fn && <Fn n={f.fn} L={L} />}</p>
      </div>
    </details>
  ))}
</div>
