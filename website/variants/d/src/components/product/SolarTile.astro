---
// Recreated "Today's flow" (app Solar tab), localised: panels → home / grid, grid → home.
import { totals as t } from '../../lib/demo.js';
interface Props { c: any }
const { c } = Astro.props;
const a = c.app; const nl = c.nl;
const pct = n => (nl ? `${n}%` : `${n} %`);
---
<div class="ptile ptile--solar">
  <div class="ptile-head">
    <svg class="icon ptile-ic ptile-ic--sun" width="18" height="18" aria-hidden="true"><use href="#i-sun" /></svg>
    <span class="ptile-title">{a.solarTitle}</span>
  </div>
  <svg class="pflow" viewBox="0 0 520 300" aria-hidden="true" focusable="false">
    <path d="M232 70 C 150 70, 96 110, 96 196" class="fl fl-elec" />
    <path d="M288 70 C 370 70, 424 110, 424 196" class="fl fl-accent" />
    <path d="M140 236 L 380 236" class="fl fl-ink" />
    <circle cx="260" cy="62" r="30" class="fn fn-sun" />
    <svg x="246" y="48" width="28" height="28" viewBox="0 0 24 24" class="fn-ic fn-ic--sun"><use href="#i-sun" /></svg>
    <text x="260" y="118" class="ft-l" text-anchor="middle">{a.panels}</text>
    <text x="260" y="142" class="ft-v" text-anchor="middle">{t.made} kWh</text>
    <circle cx="96" cy="236" r="30" class="fn" />
    <svg x="82" y="222" width="28" height="28" viewBox="0 0 24 24" class="fn-ic"><use href="#i-zap" /></svg>
    <text x="96" y="290" class="ft-l" text-anchor="middle">{a.grid}</text>
    <circle cx="424" cy="236" r="30" class="fn fn-home" />
    <svg x="410" y="222" width="28" height="28" viewBox="0 0 24 24" class="fn-ic fn-ic--home"><use href="#i-home" /></svg>
    <text x="424" y="290" class="ft-l" text-anchor="middle">{a.home}</text>
    <g class="fpill"><rect x="54" y="112" width="120" height="28" rx="14" /><text x="114" y="131" text-anchor="middle">{t.exported} {a.exported.toLowerCase()}</text></g>
    <g class="fpill"><rect x="340" y="112" width="140" height="28" rx="14" /><text x="410" y="131" text-anchor="middle">{t.self} {a.self}</text></g>
    <g class="fpill"><rect x="196" y="222" width="128" height="28" rx="14" /><text x="260" y="241" text-anchor="middle">{t.imported} {a.imported.toLowerCase()}</text></g>
  </svg>
  <div class="psolar-bar">
    <p><strong class="pnum pnum--sm">{pct(t.selfPct)}</strong> {nl ? 'van je zonnestroom zelf verbruikt' : 'de votre électricité solaire autoconsommée'}</p>
    <span class="pmeter"><span style={`width:${t.selfPct}%`}></span></span>
  </div>
  <p class="ptile-foot"><span class="pchip pchip--soft">{a.example}</span> {nl ? 'Illustratieve gegevens' : 'Données illustratives'}</p>
</div>
