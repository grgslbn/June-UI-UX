---
// "june" wordmark — our own SVG lettering in the spirit of the 2018 brush logo (not a trace).
// Colour via currentColor. Decorative text alternative is provided by the parent link.
interface Props { class?: string; title?: string }
const { class: cls = '', title } = Astro.props;
---
<svg class={`wordmark ${cls}`} viewBox="0 0 132 64" role={title ? 'img' : undefined} aria-hidden={title ? undefined : 'true'} aria-label={title} focusable="false">
  <g transform="skewX(-6) translate(6 0)" fill="none" stroke="currentColor" stroke-width="8.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M19 22 C19.5 31 19.5 40 18 47 C16.2 55.5 9 58 3.5 53" />
    <path d="M31 22 C29.5 30 29 37 33.5 38.5 C39 40 43 32 44.5 22 C44 29 43.5 34 45.5 38.5" />
    <path d="M55 38.5 C55.5 32 55.5 27 55 22 C57 26 60 21.5 65 21.5 C70 21.5 70.5 27 70 32 C69.8 35 70 37 71 38.5" />
    <path d="M82 30.5 C88 31 95.5 29 95 24.5 C94.5 20.5 88 19.5 84 22.5 C79.5 26 79.5 34 84.5 37.5 C89 40.5 96 39 100.5 35" />
  </g>
  <g transform="skewX(-6) translate(6 0)" fill="currentColor">
    <circle cx="20.5" cy="10" r="5" />
    <path d="M27 52 C50 45.5 80 44 108 47.5 C111 48 111 51.5 108 51.8 C82 50.5 55 52 29 57.5 C25 58.5 23.5 53 27 52 Z" />
  </g>
</svg>
