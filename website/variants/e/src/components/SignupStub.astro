---
// Concept-stage stub so every CTA resolves. The real 2-step flow is built in Phase 4.
import Site from '../layouts/Site.astro';
import Wordmark from './Wordmark.astro';
import Junior from './Junior.astro';
import { href } from '@shared/routes.mjs';
import type { Locale } from '../content/copy';
interface Props { locale: Locale }
const { locale } = Astro.props;
const nl = locale === 'nl-be';
---
<Site locale={locale} routeKey="signup" title={nl ? 'Aanmelden | June' : 'Inscription | June'} description={nl ? 'Meld je aan bij June in twee minuten. Je postcode en je e-mailadres volstaan om te starten.' : 'Inscrivez-vous chez June en deux minutes. Votre code postal et votre adresse e-mail suffisent pour commencer.'}>
  <main id="main" class="stub">
    <a href={href('home', locale, import.meta.env.BASE_URL)} aria-label="June, home" class="stub__logo"><Wordmark /></a>
    <h1 class="display-2">{nl ? 'Meld je aan in twee minuten' : 'Inscrivez-vous en deux minutes'}</h1>
    <p class="lede">{nl ? 'Concept: de aanmeldflow (stap 1 van 2) wordt in de volgende fase gebouwd.' : 'Concept : le parcours d’inscription (étape 1 sur 2) sera construit à la phase suivante.'}</p>
    <Junior pose="thinking" class="stub__junior" />
  </main>
</Site>
