---
import Wordmark from './Wordmark.astro';
import { href } from '@shared/routes.mjs';
import { copy, type Locale } from '../content/copy';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
const base = import.meta.env.BASE_URL;
const other: Locale = locale === 'nl-be' ? 'fr-be' : 'nl-be';
const ids = locale === 'nl-be'
  ? { how: 'hoe-werkt-het', prices: 'prijzen', reviews: 'reviews', faq: 'faq' }
  : { how: 'comment-ca-marche', prices: 'prix', reviews: 'avis', faq: 'faq' };
const nav = [[t.nav.how, ids.how], [t.nav.prices, ids.prices], [t.nav.reviews, ids.reviews], [t.nav.faq, ids.faq]];
const signup = href('signup', locale, base);
const loginUrl = '#'; // facts.brand.login.url = null → external portal URL pending (needsConfirmation)
---
<a class="skip" href="#main">{t.skip}</a>
<header class="hdr">
  <div class="hdr__in wrap">
    <a class="hdr__logo" href={href('home', locale, base)} aria-label="June, home"><Wordmark /></a>
    <nav class="hdr__nav" aria-label={t.nav.navLabel}>
      <ul>{nav.map(([label, id]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul>
    </nav>
    <div class="hdr__util">
      <p class="lang"><span class="lang__cur" aria-current="page">{t.nav.langCurrent}</span><span aria-hidden="true" class="lang__bar"></span><a href={href('home', other, base)} hreflang={other === 'fr-be' ? 'fr-BE' : 'nl-BE'} lang={other === 'fr-be' ? 'fr' : 'nl'} aria-label={t.nav.langLabel}>{t.nav.langShort}</a></p>
      <a class="hdr__login" href={loginUrl} rel="noopener" data-placeholder="login-url">{t.nav.login}<svg viewBox="0 0 12 12" aria-hidden="true" width="12" height="12"><path d="M4 2h6v6M10 2 3 9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      <a class="btn btn--white btn--sm hdr__cta" href={signup}>{t.cta}</a>
    </div>
    <details class="hdr__menu">
      <summary><span>{t.nav.menu}</span><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 8h16M4 16h16" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></summary>
      <div class="hdr__panel">
        <ul>{nav.map(([label, id]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul>
        <a class="hdr__login" href={loginUrl} rel="noopener">{t.nav.login} ↗</a>
      </div>
    </details>
  </div>
</header>
