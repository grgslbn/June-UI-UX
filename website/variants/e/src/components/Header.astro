---
// Site header on the green field. Nav: Hoe werkt het · Prijzen · Reviews · FAQ | NL/FR · Inloggen · [CTA].
// Language switch goes to the EQUIVALENT page (shared route map). Mobile menu = native <details> (zero JS).
import Logo from './Logo.astro';
import { href } from '@shared/routes.mjs';
import { copy, other, type Locale } from '../content/copy';
interface Props { locale: Locale; routeKey: string }
const { locale, routeKey } = Astro.props;
const t = copy[locale];
const base = import.meta.env.BASE_URL;
const o = other(locale);
const nav = [
  { label: t.nav.how, url: href('howItWorks', locale, base), key: 'howItWorks' },
  { label: t.nav.prices, url: href('plans', locale, base), key: 'plans' },
  { label: t.nav.reviews, url: `${href('home', locale, base)}#${t.reviewsId}`, key: '' },
  { label: t.nav.faq, url: href('faq', locale, base), key: 'faq' },
];
const cur = (k: string) => (k && (k === routeKey || (k === 'plans' && routeKey === 'switchPlus')) ? (k === routeKey ? 'page' : 'true') : undefined);
const signup = href('signup', locale, base);
const loginUrl = '#login'; // facts.brand.login.url = null → external portal URL pending (needsConfirmation)
const langLink = { href: href(routeKey, o, base), hreflang: o === 'fr-be' ? 'fr-BE' : 'nl-BE', lang: o === 'fr-be' ? 'fr' : 'nl' };
const ext = '<svg viewBox="0 0 12 12" aria-hidden="true" width="11" height="11"><path d="M4 2h6v6M10 2 3 9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<a class="skip" href="#main">{t.skip}</a>
<header class="hdr">
  <div class="hdr__in wrap">
    <a class="hdr__logo" href={href('home', locale, base)} aria-label={t.nav.home}><Logo /></a>
    <nav class="hdr__nav" aria-label={t.nav.label}>
      <ul role="list">{nav.map(n => <li><a href={n.url} aria-current={cur(n.key)}>{n.label}</a></li>)}</ul>
    </nav>
    <div class="hdr__util">
      <p class="lang"><span class="lang__cur">{t.nav.langCurrent}</span><span aria-hidden="true" class="lang__bar"></span><a href={langLink.href} hreflang={langLink.hreflang} lang={langLink.lang} aria-label={t.nav.langLabel}>{t.nav.langShort}</a></p>
      <a class="hdr__login" href={loginUrl} rel="noopener" data-placeholder="login-url">{t.nav.login}<Fragment set:html={ext} /></a>
      <a class="btn btn--white btn--sm hdr__cta" href={signup} data-cta="nav">{t.cta}</a>
    </div>
    <details class="hdr__menu">
      <summary><span>{t.nav.menu}</span><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M4 8h16M4 16h16" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></summary>
      <div class="hdr__panel">
        <ul role="list">{nav.map(n => <li><a href={n.url} aria-current={cur(n.key)}>{n.label}</a></li>)}</ul>
        <a class="hdr__login" href={loginUrl} rel="noopener">{t.nav.login}<Fragment set:html={ext} /></a>
        <a class="btn btn--ink hdr__panelcta" href={signup} data-cta="menu">{t.cta}</a>
      </div>
    </details>
  </div>
</header>
