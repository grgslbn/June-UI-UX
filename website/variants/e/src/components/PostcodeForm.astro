---
// Inline postcode → sign-up (GET ?postcode=). Native validation; the sign-up island fires signup_started on a valid postcode.
import { href } from '@shared/routes.mjs';
import { copy, type Locale } from '../content/copy';
interface Props { locale: Locale; id: string; tone?: 'field' | 'light'; plan?: string; cta?: string; loc?: string }
const { locale, id, tone = 'field', plan, cta, loc = id } = Astro.props;
const t = copy[locale];
---
<form class={`pc pc--${tone}`} action={href('signup', locale, import.meta.env.BASE_URL)} method="get" data-cta-form={loc}>
  <label class="pc__label" for={id}>{t.postcode.label}</label>
  <div class="pc__row">
    <input class="pc__input" id={id} name="postcode" type="text" inputmode="numeric" autocomplete="postal-code" pattern="[1-9][0-9]{3}" maxlength="4" required placeholder={t.postcode.placeholder} aria-describedby={`${id}-help`} />
    {plan && <input type="hidden" name="plan" value={plan} />}
    <button class={`btn ${tone === 'field' ? 'btn--ink' : 'btn--ink'} pc__btn`} type="submit"><span>{cta || t.cta}</span><svg class="btn__arrow" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M4 10h11m-4-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
  </div>
  <p class="pc__help" id={`${id}-help`}>{t.postcode.help}</p>
</form>
