---
// Halftone dot patch (corner decoration, never behind text). Fades out with a radial mask.
interface Props { id: string; class?: string; size?: number; r?: number; gap?: number }
const { id, class: cls = '', r = 2.2, gap = 10 } = Astro.props;
---
<svg class={`halftone ${cls}`} viewBox="0 0 160 160" aria-hidden="true" focusable="false">
  <defs>
    <pattern id={`${id}-p`} width={gap} height={gap} patternUnits="userSpaceOnUse"><circle cx={gap / 2} cy={gap / 2} r={r} fill="currentColor" /></pattern>
    <radialGradient id={`${id}-g`} cx="30%" cy="30%" r="75%"><stop offset=".2" stop-color="#fff" /><stop offset="1" stop-color="#000" /></radialGradient>
    <mask id={`${id}-m`}><rect width="160" height="160" fill={`url(#${id}-g)`} /></mask>
  </defs>
  <rect width="160" height="160" fill={`url(#${id}-p)`} mask={`url(#${id}-m)`} />
</svg>
