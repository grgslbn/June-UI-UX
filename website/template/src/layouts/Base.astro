---
const { lang = 'nl-be', title, description } = Astro.props;
const html = lang.startsWith('fr') ? 'fr-BE' : 'nl-BE';
---
<!doctype html>
<html lang={html}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body><slot /></body>
</html>
